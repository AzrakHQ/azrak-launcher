import { S, Theme, Icons, ChipData, ActionData } from "theme.slint";

// White focus ring with a soft blue halo, drawn around its parent.
export component FocusRing inherits Rectangle {
    in property <length> radius: (16px * S.k);
    in property <bool> on;
    in property <length> w;
    in property <length> h;
    x: -(4px * S.k);
    y: -(4px * S.k);
    width: w + (8px * S.k);
    height: h + (8px * S.k);
    border-radius: self.radius + (4px * S.k);
    border-width: (4px * S.k);
    border-color: Theme.ring;
    opacity: self.on ? 1 : 0;
    drop-shadow-blur: self.on ? (18px * S.k) : 0;
    drop-shadow-color: Theme.glow;
    animate opacity { duration: Theme.fast; }
}

// Five stars filled to `score` (e.g. 3.74 → three full stars and most of the fourth).
export component Stars inherits HorizontalLayout {
    in property <float> score;
    in property <length> size: (17px * S.k);
    spacing: (2px * S.k);
    for i in [0, 1, 2, 3, 4]: Rectangle {
        width: root.size;
        height: root.size;
        Image { source: Icons.star; colorize: #ffffff33; width: root.size; height: root.size; }
        Rectangle {
            x: 0;
            width: root.size * clamp(root.score - i, 0, 1);
            height: root.size;
            clip: true;
            Image { x: 0; source: Icons.star; colorize: #ffc940; width: root.size; height: root.size; }
        }
    }
}

export component KeyCap inherits Rectangle {
    in property <string> text;
    in property <bool> round;
    in property <color> fg: #ffffff;
    in property <color> bg: #ffffff24;
    height: (30px * S.k);
    width: round ? (30px * S.k) : max((30px * S.k), t.preferred-width + (16px * S.k));
    border-radius: round ? (15px * S.k) : (8px * S.k);
    background: bg;
    border-width: 1px;
    border-color: #ffffff1f;
    t := Text { text: root.text; font-size: (15px * S.k); font-weight: 700; color: root.fg; }
}

// Quiet navigation, not another primary action. Shortcut appears on hover; no layout jump.
export component BackButton inherits Rectangle {
    in property <bool> pad;
    callback clicked();
    width: (154px * S.k);
    height: (48px * S.k);
    border-radius: (12px * S.k);
    background: ta.has-hover ? #ffffff16 : transparent;
    animate background { duration: 120ms; }
    row := HorizontalLayout {
        padding-left: (6px * S.k);
        padding-right: (8px * S.k);
        spacing: (12px * S.k);
        alignment: center;
        Rectangle {
            width: (36px * S.k); height: (36px * S.k); y: (6px * S.k);
            border-radius: (18px * S.k); background: ta.has-hover ? #ffffff24 : #ffffff12;
            Image { source: Icons.chevl; colorize: Theme.text; width: (22px * S.k); height: (22px * S.k); x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
        }
        Text { text: "Back"; font-size: (18px * S.k); font-weight: 500; color: Theme.text; vertical-alignment: center; }
        Text {
            text: root.pad ? "○" : "Esc"; font-size: (15px * S.k); color: root.pad ? #ff8f9c : Theme.text3;
            vertical-alignment: center; opacity: root.pad || ta.has-hover ? 1 : 0;
            animate opacity { duration: 120ms; }
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component Chip inherits Rectangle {
    in property <ChipData> data;
    height: (40px * S.k);
    border-radius: (20px * S.k);
    background: #ffffff17;
    border-width: 1px;
    border-color: #ffffff12;
    HorizontalLayout {
        padding-left: (16px * S.k);
        padding-right: (16px * S.k);
        spacing: (8px * S.k);
        if data.stars > 0: Stars {
            score: data.stars;
            y: (parent.height - self.preferred-height) / 2;
        }
        if data.dot > 0: Rectangle {
            width: (10px * S.k);
            height: (10px * S.k);
            y: (parent.height - self.height) / 2;
            border-radius: (5px * S.k);
            background: Theme.compat-color(data.dot);
        }
        if data.icon != "": Image {
            source: Icons.get(data.icon);
            colorize: data.gold ? #ffc940 : Theme.text2;
            width: (18px * S.k);
            height: (18px * S.k);
            y: (parent.height - self.height) / 2;
        }
        Text {
            text: data.text;
            color: Theme.text;
            font-size: (17px * S.k);
            vertical-alignment: center;
        }
    }
}

export component Btn inherits Rectangle {
    in property <ActionData> data;
    in property <bool> focused;
    // Another button in the same row is selected: the primary button steps back so only one
    // button ever looks selected.
    in property <bool> dim;
    in property <length> h: (68px * S.k);
    property <bool> solid: focused || (data.primary && !dim);
    callback clicked();
    // Icon-only buttons show their label when selected or hovered.
    property <bool> open: !data.round || focused || ta.has-hover;
    height: h;
    width: !open ? h : max(data.primary ? (240px * S.k) : (0px * S.k), row.preferred-width);
    clip: true;
    transform-scale: focused ? 1.05 : 1.0;
    animate width { duration: 300ms; easing: ease-out-expo; }
    animate transform-scale { duration: 220ms; easing: ease-out-back; }
    border-radius: h / 2;
    background: focused ? (data.danger ? Theme.danger : #ffffff)
        : data.primary && !dim ? #ffffffeb : data.danger ? #ff5a6a2e : data.primary ? #ffffff38 : #ffffff24;
    border-width: 1px;
    border-color: data.danger && !focused ? #ff5a6a5a : #ffffff1a;
    drop-shadow-blur: focused ? (28px * S.k) : 0;
    drop-shadow-color: focused ? #8cb9ffaa : transparent;
    animate background, drop-shadow-blur { duration: Theme.fast; }
    row := HorizontalLayout {
        alignment: center;
        padding-left: !open ? 0 : data.round ? (22px * S.k) : (36px * S.k);
        padding-right: !open ? 0 : data.round ? (26px * S.k) : (36px * S.k);
        spacing: (12px * S.k);
        Image {
            source: Icons.get(data.icon);
            colorize: solid && !(focused && data.danger) ? #0a0d18 : #ffffff;
            width: (26px * S.k);
            height: (26px * S.k);
            y: (parent.height - self.height) / 2;
        }
        if open: Text {
            text: data.label;
            font-size: (22px * S.k);
            font-weight: 600;
            color: solid && !(focused && data.danger) ? #0a0d18 : #ffffff;
            vertical-alignment: center;
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Small caps line above a title: "● PLAYING 0:12", "NEW · ADDED SEP 22, 2026", "PLAYED 2 HR".
export component Kicker inherits HorizontalLayout {
    in property <string> text;
    in property <string> accent;
    in property <bool> live;
    spacing: (12px * S.k);
    alignment: start;
    height: (30px * S.k);
    if accent != "": Text {
        text: accent;
        font-size: (18px * S.k);
        font-weight: 600;
        letter-spacing: (2px * S.k);
        color: Theme.ok;
        vertical-alignment: center;
    }
    Text {
        text: root.text;
        font-size: (18px * S.k);
        font-weight: 600;
        letter-spacing: (2px * S.k);
        color: live ? Theme.text : Theme.text2;
        vertical-alignment: center;
    }
}

export component Badge inherits Rectangle {
    in property <string> text;
    in property <length> size: (13px * S.k);
    visible: text != "";
    width: label.preferred-width + (16px * S.k);
    height: label.preferred-height + (6px * S.k);
    border-radius: (6px * S.k);
    background: text == "Installed" ? Theme.ok : text == "Playing" ? Theme.ok : text == "New" ? Theme.accent : #000000b8;
    label := Text {
        text: root.text == "Playing" ? "● PLAYING" : root.text == "Installed" ? "INSTALLED" : root.text == "New" ? "NEW" : root.text;
        font-size: size;
        font-weight: 700;
        letter-spacing: (1px * S.k);
        color: root.text == "Installed" || root.text == "Playing" ? #03140c : #ffffff;
    }
}

export component Switch inherits Rectangle {
    in property <bool> on;
    width: (58px * S.k);
    height: (32px * S.k);
    border-radius: (16px * S.k);
    background: on ? Theme.accent : #ffffff33;
    animate background { duration: Theme.fast; }
    Rectangle {
        x: on ? (30px * S.k) : (4px * S.k);
        y: (4px * S.k);
        width: (24px * S.k);
        height: (24px * S.k);
        border-radius: (12px * S.k);
        background: #ffffff;
        animate x { duration: Theme.move; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
    }
}

// Loading placeholder: a soft light sweeping across. Only animates while it is shown.
export component Shimmer inherits Rectangle {
    in property <bool> active;
    clip: true;
    visible: active;
    property <float> t: active ? animation-tick() / 1ms / 1000 : 0;
    Rectangle {
        x: (mod(t * 0.8, 1.6) - 0.3) * parent.width - self.width / 2;
        width: parent.width * 0.6;
        background: @linear-gradient(90deg, #ffffff00 0%, #ffffff12 50%, #ffffff00 100%);
    }
}

// Cover art that never crops a logo: art with the frame's shape fills it; any other shape
// (square icons, landscape art) is shown whole, centred over a dimmed, stretched copy.
export component Cover inherits Rectangle {
    in property <image> source;
    in property <bool> loaded;
    property <float> aspect: source.height > 0 ? source.width / source.height : 0;
    property <float> frame: root.height > 0 ? root.width / root.height : 1;
    property <bool> fits: aspect > 0 && abs(aspect - frame) / frame < 0.08;
    if loaded && !fits: Image {
        source: root.source;
        width: parent.width;
        height: parent.height;
        image-fit: cover;
        opacity: 0.45;
    }
    if loaded && !fits: Rectangle { background: #05070f8c; }
    Image {
        source: root.source;
        width: parent.width;
        height: parent.height;
        image-fit: root.fits ? cover : contain;
        opacity: root.loaded ? 1 : 0;
        animate opacity { duration: 250ms; }
    }
}
