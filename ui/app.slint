import { S, Theme, Icons, Zone, DownloadData, BootStep, WjKey, ChipData, ActionData, TileData, HeroData, CardData, CardRow, GenreChip, Fact, FactRow, Shot, HubData, SettingData, ToastData, MenuItem, RunningData } from "theme.slint";
import { FocusRing, Chip, Btn, Kicker, Badge, Switch, KeyCap, BackButton, Shimmer, Cover } from "widgets.slint";
import { DownloadsSheet, DownloadConsent } from "downloads.slint";
import { LibraryFilter, LibrarySortPicker } from "library.slint";
import { AboutSlint, Palette } from "std-widgets.slint";

export { S, Theme, Zone }

// Notification card: icon tile, title, message. Slides in from the right.
component Toast inherits Rectangle {
    in property <ToastData> data;
    callback clicked();
    property <bool> shown: false;
    property <color> tint: data.kind == 1 ? Theme.ok : data.kind == 2 ? Theme.danger : #3d8bff;
    init => { shown = true; }
    width: (440px * S.k);
    height: max((84px * S.k), body.preferred-height + (36px * S.k));
    border-radius: (18px * S.k);
    background: #141c33fa;
    border-width: 1px;
    border-color: #ffffff1f;
    drop-shadow-blur: (36px * S.k);
    drop-shadow-offset-y: (10px * S.k);
    drop-shadow-color: #00000099;
    opacity: shown ? 1 : 0;
    transform-scale: shown ? 1.0 : 0.96;
    animate opacity { duration: 240ms; easing: ease-out-quad; }
    animate transform-scale { duration: 360ms; easing: ease-out-back; }
    if data.action != "": touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    // Icon tile: a real picture when we have one, otherwise a tinted symbol.
    Rectangle {
        x: (18px * S.k);
        y: (18px * S.k);
        width: (48px * S.k);
        height: (48px * S.k);
        border-radius: (13px * S.k);
        clip: true;
        background: data.has-image || data.app ? #00000000 : root.tint.with-alpha(0.18);
        if data.app: Image { source: Icons.app; width: parent.width; height: parent.height; }
        if data.has-image && !data.app: Image { source: data.image; width: parent.width; height: parent.height; image-fit: cover; }
        if !data.has-image && !data.app: Image {
            source: data.kind == 1 ? Icons.check : data.kind == 2 ? Icons.alert : Icons.info;
            colorize: root.tint;
            width: (26px * S.k);
            height: (26px * S.k);
        }
    }
    body := VerticalLayout {
        x: (82px * S.k);
        y: (18px * S.k);
        width: parent.width - (82px * S.k) - (22px * S.k);
        height: parent.height - (36px * S.k);
        alignment: center;
        spacing: (3px * S.k);
        Text { text: data.text; font-size: (18px * S.k); font-weight: 600; color: Theme.text; wrap: word-wrap; }
        if data.sub != "": Text {
            text: data.sub;
            font-size: (15px * S.k);
            color: Theme.text2;
            wrap: word-wrap;
            max-height: (120px * S.k);
            overflow: elide;
        }
    }
}

// One layer of the Home hero. Two of these crossfade on every selection change.
component HeroView inherits Rectangle {
    in property <HeroData> data;
    in property <bool> front;
    in property <int> focus-idx: -1;
    in property <length> base-y;
    callback action(int);
    // Incoming details rise into place; outgoing ones fade quickly and drift down.
    y: base-y + (front ? 0 : (18px * S.k));
    opacity: front ? 1 : 0;
    visible: self.opacity > 0.01;
    animate y { duration: front ? 380ms : 160ms; easing: ease-out-expo; }
    animate opacity { duration: front ? 300ms : 140ms; easing: ease-out-quad; }
    VerticalLayout {
        alignment: end;
        spacing: 0;
        if data.kicker != "" || data.kicker-accent != "": Kicker { text: data.kicker; accent: data.kicker-accent; live: data.kicker-live; }
        if data.kicker != "" || data.kicker-accent != "": Rectangle { height: (14px * S.k); }
        if data.has-logo: Image {
            source: data.logo;
            width: data.logo-w;
            height: data.logo-h;
            image-fit: contain;
        }
        if !data.has-logo: Text {
            text: data.title;
            font-size: (84px * S.k);
            font-weight: 700;
            color: Theme.text;
            wrap: word-wrap;
            overflow: elide;
            max-height: (180px * S.k);
        }
        Rectangle { height: (22px * S.k); }
        HorizontalLayout {
            spacing: (10px * S.k);
            alignment: start;
            for c in data.chips: Chip { data: c; }
        }
        Rectangle { height: (20px * S.k); }
        Text {
            text: data.desc;
            font-size: (21px * S.k);
            color: Theme.text2;
            wrap: word-wrap;
            overflow: elide;
            max-width: (780px * S.k);
            max-height: (96px * S.k);
        }
        Rectangle { height: (34px * S.k); }
        HorizontalLayout {
            spacing: (16px * S.k);
            alignment: start;
            for a[i] in data.actions: Btn {
                data: a;
                focused: root.front && root.focus-idx == i;
                dim: root.front && root.focus-idx >= 0 && root.focus-idx != i;
                clicked => { root.action(i); }
            }
        }
    }
}

export component AppWindow inherits Window {
    title: "Azrak Launcher";
    icon: @image-url("../assets/icons/app-icon.svg");
    background: Theme.bg;
    default-font-family: "Inter";
    default-font-size: (22px * S.k);
    // No preferred size: the window's size comes from the window manager / place_window, and the
    // UI scale follows it (see App::fit_scale). A preferred size would fight every rescale.
    min-width: 640px;
    min-height: 360px;
    // The UI is always dark: keep std widgets (AboutSlint's logo) on the dark variant.
    init => { Palette.color-scheme = ColorScheme.dark; }

    // ---------------------------------------------------------------- state from Rust
    in property <int> view;          // 0 home, 1 library
    in property <int> overlay;       // 0 none, 1 hub, 2 settings, 3 viewer, 4 launch, 5 menu
    in property <int> zone;
    in property <int> idx;
    in property <string> clock;
    in property <string> app-version;
    in property <RunningData> running;
    in property <[ToastData]> toasts;
    in property <string> status;
    in property <bool> status-busy;
    in property <[DownloadData]> downloads;
    in property <bool> download-active;
    in property <float> download-progress;
    in property <string> download-badge;
    in property <string> download-summary;
    in property <bool> download-consent;
    in property <bool> download-is-install;
    in-out property <bool> download-focus-path;
    in property <bool> install-active;
    in property <float> install-progress;
    in property <string> install-badge;
    in property <string> download-title;
    in property <string> download-error;
    in property <string> download-privacy;
    in property <string> download-install-note;
    in property <string> download-warning;
    in-out property <string> download-path;
    in-out property <bool> download-editing;
    in-out property <length> downloads-y;
    in property <bool> pad-hints;
    // Trailer player: video frames come from libmpv through an OpenGL texture (src/trailer.rs).
    in property <image> trailer-frame;
    in property <string> trailer-title;
    in property <float> trailer-progress;
    in property <string> trailer-time;
    in property <bool> trailer-paused;
    in property <bool> trailer-loading;
    in property <bool> trailer-controls;
    in property <image> bg-a;
    in property <image> bg-b;
    in property <bool> bg-show-b;
    in property <bool> bg-dim;

    in property <[TileData]> tiles;
    in property <int> sel;
    in property <string> row-name;
    in property <string> row-name-b;
    in property <string> row-sub-b;
    in property <bool> row-front-b;
    in property <string> row-sub;
    in property <HeroData> hero;
    in property <HeroData> hero-b;
    in property <bool> hero-front-b;

    in-out property <string> query;
    in property <string> sort-label;
    in property <string> count-label;
    in property <string> peer-snapshot-label;
    in property <[string]> sort-options;
    in property <int> sort-selected;
    in property <bool> library-compact;
    in property <float> library-type-scale: 1;
    in property <length> library-top: (324px * S.k);
    in property <[GenreChip]> status-filters;
    property <length> library-sort-anchor: (96px * S.k) + library-search.width + (18px * S.k);
    in property <[GenreChip]> genres;
    in property <length> genres-x;
    in property <bool> genres-more-right;
    in property <length> status-filters-end; // right edge of the last status/console chip
    in property <[CardRow]> grid-rows;
    in-out property <length> grid-y;
    in property <duration> grid-glide;
    in property <length> grid-h;
    in property <length> card-w;
    in property <length> row-h;
    in property <length> grid-gap;
    in property <string> grid-empty;

    in property <HubData> hub;
    in property <bool> hub-open;
    in property <bool> home-has-game: true;
    in-out property <length> hub-content-h;
    out property <length> hub-text-w: min((1060px * S.k), root.width - (540px * S.k) - (96px * S.k));
    in-out property <length> hub-col-h;
    out property <length> hub-view-h: root.height;
    in-out property <length> hub-y;
    in property <length> shots-x;

    in property <[SettingData]> settings;
    in-out property <length> settings-y;
    in property <int> edit-index: -1;
    in-out property <string> edit-text;

    in property <image> viewer-image;
    in property <string> viewer-count;

    in property <image> launch-bg;
    in property <image> launch-icon;
    in property <string> launch-name;
    in property <string> launch-sub: "Starting with KytyPS5…";
    // Which controller the game will get; without one, the keyboard layout is shown.
    in property <string> launch-controller;
    in property <bool> launch-keyboard;
    // PS4 games run on shadPS4, whose keyboard layout differs from KytyPS5's.
    in property <bool> launch-ps4;
    in property <bool> controls-ps4;
    // Joining a secured Wi-Fi network (wifi_join.rs): the field shows dots unless wj-show.
    in property <string> wj-ssid;
    in property <string> wj-sub;
    in property <string> wj-field;
    in property <bool> wj-show;
    in property <string> wj-error;
    in property <bool> wj-busy;
    in property <[WjKey]> wj-row0;
    in property <[WjKey]> wj-row1;
    in property <[WjKey]> wj-row2;
    in property <[WjKey]> wj-row3;
    in property <[WjKey]> wj-row4;

    in property <string> menu-title;
    in property <[MenuItem]> menu-items;

    in property <bool> boot-first;
    in property <bool> boot-ready;
    in property <float> boot-progress;
    in property <string> boot-status;
    in property <string> boot-detail;
    in property <[BootStep]> boot-steps;
    in property <[image]> boot-covers;

    // ---------------------------------------------------------------- callbacks to Rust
    callback key(string, bool, bool, bool) -> bool;   // text, ctrl, alt, repeat
    callback click(int, int);                         // zone, index
    callback row-wheel(float);
    callback grid-scrolled();
    callback grid-wheel(float);
    callback resized();
    callback search-edited(string);
    callback search-done(bool);                       // accepted (Enter)
    callback edit-done(string, bool);
    callback download-confirm();
    callback download-action(string, string);
    callback toast-clicked(int, string);            // id, action
    callback trailer-action(string);                // toggle, close, controls, seek:<0..1>
    callback download-close();
    callback hub-release(int);
    callback genres-scroll(int);
    in-out property <bool> hub-details-open;

    public function focus-root() { scope.focus(); }
    public function focus-search() { search-input.focus(); search-input.select-all(); }

    changed width => { root.resized(); }
    changed height => { root.resized(); }

    scope := FocusScope {
        init => { self.focus(); }
        key-pressed(e) => {
            return root.key(e.text, e.modifiers.control, e.modifiers.alt, e.repeat) ? EventResult.accept : EventResult.reject;
        }

        // ------------------------------------------------------------ background
        Rectangle {
            background: @radial-gradient(circle, #13204a 0%, Theme.bg 70%);
        }
        Image {
            source: root.bg-a;
            width: root.width;
            height: root.height;
            image-fit: cover;
            opacity: root.bg-show-b ? 0 : 1;
            // The incoming backdrop settles from a slight zoom while it fades in.
            transform-scale: root.bg-show-b ? 1.06 : 1.0;
            animate opacity { duration: 520ms; easing: ease-out-quad; }
            animate transform-scale { duration: root.bg-show-b ? 0ms : 1600ms; easing: ease-out-quint; }
        }
        Image {
            source: root.bg-b;
            width: root.width;
            height: root.height;
            image-fit: cover;
            opacity: root.bg-show-b ? 1 : 0;
            transform-scale: root.bg-show-b ? 1.0 : 1.06;
            animate opacity { duration: 520ms; easing: ease-out-quad; }
            animate transform-scale { duration: root.bg-show-b ? 1600ms : 0ms; easing: ease-out-quint; }
        }
        Rectangle { background: @linear-gradient(90deg, #04060ef0 0%, #04060eb8 30%, #04060e2e 62%, #04060e00 80%); }
        Rectangle { background: @linear-gradient(0deg, #04060ef5 0%, #04060e59 38%, #04060e00 60%); }
        Rectangle { background: @linear-gradient(180deg, #04060ed9 0%, #04060e00 26%); }
        Rectangle {
            background: #04060e;
            opacity: root.bg-dim ? 0.84 : 0;
            animate opacity { duration: 300ms; }
        }

        // ------------------------------------------------------------ HOME
        home := Rectangle {
            opacity: root.view == 0 ? 1 : 0;
            visible: self.opacity > 0;
            x: root.view == 0 ? 0 : -(40px * S.k);
            animate opacity { duration: 260ms; easing: ease-out-quad; }
            animate x { duration: 420ms; easing: ease-out-expo; }

            // Tile row: the selected tile is larger with its name beside it (PS5 home).
            property <length> big: (172px * S.k);
            property <length> small: (112px * S.k);
            property <length> gap: (22px * S.k);
            property <length> x0: (96px * S.k);
            property <length> label-w: min((560px * S.k), max(row-name-t.preferred-width, row-sub-t.preferred-width)) + gap * 2.6;

            Rectangle {
                y: (128px * S.k);
                height: (210px * S.k);
                for t[i] in root.tiles: Rectangle {
                    x: i < root.sel ? home.x0 - (root.sel - i) * (home.small + home.gap) - home.gap
                        : i == root.sel ? home.x0 : home.x0 + home.big + home.label-w + (i - root.sel - 1) * (home.small + home.gap);
                    y: 0;
                    width: i == root.sel ? home.big : home.small;
                    height: self.width;
                    opacity: i < root.sel ? 0 : 1;
                    visible: self.x < root.width + (40px * S.k) && i >= root.sel - 2;
                    animate x, width { duration: 360ms; easing: ease-out-expo; }
                    animate opacity { duration: 220ms; easing: ease-out-quad; }
                    FocusRing { w: parent.width; h: parent.height; on: i == root.sel && root.zone == Zone.row && root.overlay == 0; radius: (18px * S.k); }
                    Rectangle {
                        border-radius: (18px * S.k);
                        clip: true;
                        background: t.special ? #ffffff1f : Theme.panel;
                        border-width: t.special ? 1px : 0;
                        border-color: Theme.line;
                        drop-shadow-blur: 0;
                        if !t.special: Image {
                            source: t.image;
                            width: parent.width;
                            height: parent.height;
                            image-fit: cover;
                            opacity: t.loaded ? 1 : 0;
                            animate opacity { duration: 250ms; }
                        }
                        if t.special: Image {
                            source: Icons.grid;
                            colorize: Theme.text;
                            width: parent.width * 0.42;
                            height: self.width;
                        }
                    }
                    if t.badge != "": Badge {
                        x: (10px * S.k);
                        y: parent.height - self.height - (10px * S.k);
                        text: t.badge;
                        size: i == root.sel ? (13px * S.k) : (10px * S.k);
                    }
                    Rectangle {
                        border-radius: (18px * S.k);
                        border-width: t.badge == "Playing" ? (3px * S.k) : 0;
                        border-color: Theme.ok;
                    }
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.click(Zone.row, i); }
                    }
                }
                // Name beside the selected tile: sized by the front slot; the two slots crossfade.
                row-name-t := Text { visible: false; text: root.row-front-b ? root.row-name-b : root.row-name; font-size: (30px * S.k); font-weight: 500; }
                row-sub-t := Text { visible: false; text: root.row-front-b ? root.row-sub-b : root.row-sub; font-size: (18px * S.k); }
                for slot in [0, 1]: Rectangle {
                    property <bool> front: (slot == 1) == root.row-front-b;
                    x: home.x0 + home.big + home.gap * 1.2 + (front ? 0 : (14px * S.k));
                    y: 0;
                    height: home.big;
                    width: min((560px * S.k), max(row-name-t.preferred-width, row-sub-t.preferred-width));
                    opacity: front ? 1 : 0;
                    animate opacity { duration: front ? 280ms : 120ms; easing: ease-out-quad; }
                    animate x { duration: front ? 360ms : 120ms; easing: ease-out-expo; }
                    VerticalLayout {
                        alignment: center;
                        spacing: (6px * S.k);
                        Text { text: slot == 0 ? root.row-name : root.row-name-b; font-size: (30px * S.k); font-weight: 500; color: Theme.text; overflow: elide; }
                        Text { text: slot == 0 ? root.row-sub : root.row-sub-b; font-size: (18px * S.k); color: Theme.text2; overflow: elide; }
                    }
                }
                TouchArea {
                    scroll-event(e) => {
                        root.row-wheel((e.delta-y + e.delta-x) / 1px);
                        return EventResult.accept;
                    }
                }
            }

            // Hero: two layers crossfade when the selection changes (the new game's details
            // rise in while the old ones fade), like the PS5 home screen.
            for slot in [0, 1]: HeroView {
                x: (96px * S.k);
                width: (900px * S.k);
                base-y: (360px * S.k);
                height: root.height - (360px * S.k) - (112px * S.k);
                data: slot == 0 ? root.hero : root.hero-b;
                front: (slot == 1) == root.hero-front-b;
                focus-idx: root.zone == Zone.actions && root.overlay == 0 ? root.idx : -1;
                action(i) => { root.click(Zone.actions, i); }
            }
        }

        // ------------------------------------------------------------ LIBRARY
        Rectangle {
            opacity: root.view == 1 ? 1 : 0;
            visible: self.opacity > 0;
            x: root.view == 1 ? 0 : (40px * S.k);
            animate opacity { duration: 260ms; easing: ease-out-quad; }
            animate x { duration: 420ms; easing: ease-out-expo; }

            // Grid (virtualized: only rows near the viewport exist).
            // Scrolling is driven from Rust (wheel, touchpad, keyboard, controller) so each input
            // gets the right step and a short glide; only rows near the viewport exist.
            grid := Rectangle {
                y: root.library-top;
                height: root.height - root.library-top;
                width: root.width;
                clip: true;
                TouchArea {
                    scroll-event(e) => {
                        root.grid-wheel(e.delta-y / 1px);
                        return EventResult.accept;
                    }
                }
                Rectangle {
                y: root.grid-y;
                height: root.grid-h;
                animate y { duration: root.grid-glide; easing: ease-out-quart; }
                for r in root.grid-rows: Rectangle {
                    y: r.index * root.row-h + (26px * S.k);
                    height: root.row-h;
                    for c[j] in r.cards: Rectangle {
                        x: (96px * S.k) + j * (root.card-w + root.grid-gap);
                        width: root.card-w;
                        height: root.row-h;
                        property <bool> f: root.zone == Zone.grid && root.idx == c.index && root.overlay == 0;
                        Rectangle {
                            y: 0;
                            height: root.card-w * 1.5;   // official covers are 2:3
                            transform-scale: f ? 1.05 : 1.0;
                            animate transform-scale { duration: 220ms; easing: ease-out-back; }
                            FocusRing { w: parent.width; h: parent.height; on: f; radius: (14px * S.k); }
                            Rectangle {
                                border-radius: (14px * S.k);
                                clip: true;
                                background: Theme.panel;
                                Shimmer { active: !c.loaded && !c.no-art; }
                                Cover { source: c.image; loaded: c.loaded; }
                                // No artwork for this game: its name, on the console's colours.
                                if c.no-art: Rectangle {
                                    background: c.console == "PC" ? @linear-gradient(160deg, #1d3a2f 0%, #0d1714 100%)
                                        : c.console == "PS4" ? @linear-gradient(160deg, #1b2d52 0%, #0b1224 100%)
                                        : @linear-gradient(160deg, #26304f 0%, #0e1222 100%);
                                    Text {
                                        x: parent.width * 0.1;
                                        width: parent.width * 0.8;
                                        text: c.title;
                                        font-size: max((15px * S.k), parent.width * 0.11);
                                        font-weight: 700;
                                        color: #e8ecf6;
                                        wrap: word-wrap;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                                Badge { x: (10px * S.k); y: (10px * S.k); text: c.badge; size: (12px * S.k); }
                                if c.console != "": Rectangle {
                                    x: parent.width - self.width - (10px * S.k);
                                    y: (10px * S.k);
                                    width: cl.preferred-width + (14px * S.k);
                                    height: (22px * S.k);
                                    border-radius: (6px * S.k);
                                    background: #000000c4;
                                    cl := Text { text: c.console; font-size: (12px * S.k); font-weight: 700; color: c.console == "PS4" ? #8fc2ff : #ffffff; }
                                }
                                if c.compat != "": Rectangle {
                                    x: (10px * S.k);
                                    y: parent.height - self.height - (10px * S.k);
                                    width: cp.preferred-width + (30px * S.k);
                                    height: (26px * S.k);
                                    border-radius: (6px * S.k);
                                    background: #000000c4;
                                    Rectangle {
                                        x: (9px * S.k);
                                        width: (8px * S.k);
                                        height: (8px * S.k);
                                        border-radius: (4px * S.k);
                                        background: Theme.compat-color(c.compat-level);
                                    }
                                    cp := Text {
                                        x: (23px * S.k);
                                        text: c.compat;
                                        font-size: (13px * S.k);
                                        font-weight: 700;
                                        color: #ffffff;
                                    }
                                }
                                if c.rating != "": Rectangle {
                                    x: parent.width - self.width - (10px * S.k);
                                    y: parent.height - self.height - (10px * S.k);
                                    width: rt.preferred-width + (16px * S.k);
                                    height: (26px * S.k);
                                    border-radius: (6px * S.k);
                                    background: #000000b8;
                                    rt := Text { text: "★ " + c.rating; font-size: (14px * S.k); font-weight: 700; color: #ffd666; }
                                }
                            }
                        }
                        VerticalLayout {
                            y: root.card-w * 1.5 + (14px * S.k);
                            width: parent.width;
                            height: (102px * root.library-type-scale) + (8px * S.k);
                            alignment: start;
                            spacing: (4px * S.k);
                            // Every card reserves two title lines, including short titles.
                            Rectangle {
                                height: (52px * root.library-type-scale);
                                clip: true;
                                title-t := Text {
                                    y: 0;
                                    width: parent.width;
                                    height: parent.height;
                                    text: c.title;
                                    font-size: (20px * root.library-type-scale);
                                    font-weight: 500;
                                    color: f ? #ffffff : Theme.text;
                                    wrap: word-wrap;
                                    overflow: elide;
                                    vertical-alignment: top;
                                }
                            }
                            HorizontalLayout {
                                height: (26px * root.library-type-scale);
                                spacing: (6px * S.k);
                                Text { text: c.meta; font-size: (18px * root.library-type-scale); font-weight: 500; color: Theme.text2; overflow: elide; }
                                Rectangle { horizontal-stretch: 1; }
                                if c.releases != "": Text { text: c.releases; font-size: (14px * root.library-type-scale); color: Theme.text3; overflow: elide; }
                            }
                            HorizontalLayout {
                                height: (24px * root.library-type-scale);
                                spacing: (8px * S.k);
                                alignment: start;
                                Text { text: "↑ " + c.seeders; font-size: (16px * root.library-type-scale); font-weight: 500; color: c.seeders == "—" ? Theme.text3 : Theme.ok; }
                                Text { text: "↓ " + c.leechers; font-size: (16px * root.library-type-scale); font-weight: 500; color: c.leechers == "—" ? Theme.text3 : Theme.danger; }
                            }
                        }
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.click(Zone.grid, c.index); }
                        }
                    }
                }
                }
            }
            if root.grid-empty != "": Text {
                y: (420px * S.k);
                width: root.width;
                horizontal-alignment: center;
                text: root.grid-empty;
                font-size: (24px * S.k);
                color: Theme.text3;
            }

            // Header: search, sort, count, genre chips.
            Rectangle {
                y: 0;
                height: root.library-top;
                background: @linear-gradient(180deg, #070a14 0%, #070a14 88%, #070a1400 100%);
                HorizontalLayout {
                    x: (96px * S.k);
                    y: (112px * S.k);
                    width: root.width - (192px * S.k);
                    height: (62px * S.k);
                    spacing: (18px * S.k);
                    library-search := Rectangle {
                        width: min((600px * S.k), max((180px * S.k), parent.width - library-sort.width - density.width - (54px * S.k)));
                        border-radius: (31px * S.k);
                        background: root.zone == Zone.search ? #232c47 : #ffffff14;
                        border-width: root.zone == Zone.search ? (3px * S.k) : (1px * S.k);
                        border-color: root.zone == Zone.search ? #ffffff : Theme.line;
                        drop-shadow-blur: root.zone == Zone.search ? (18px * S.k) : 0;
                        drop-shadow-color: #3d8bff66;
                        Image { x: (24px * S.k); source: Icons.search; colorize: Theme.text2; width: (24px * S.k); height: (24px * S.k); }
                        search-input := TextInput {
                            x: (62px * S.k);
                            width: parent.width - (86px * S.k);
                            height: parent.height;
                            vertical-alignment: center;
                            font-size: (22px * root.library-type-scale);
                            color: Theme.text;
                            text <=> root.query;
                            single-line: true;
                            edited => { root.search-edited(self.text); }
                            accepted => { root.search-done(true); }
                        }
                        if root.query == "": Text {
                            x: (62px * S.k);
                            text: "Search games";
                            font-size: (22px * root.library-type-scale);
                            color: Theme.text3;
                            vertical-alignment: center;
                        }
                        TouchArea {
                            mouse-cursor: text;
                            clicked => { root.click(Zone.search, 0); }
                        }
                    }
                    library-sort := Rectangle {
                        width: sort-row.preferred-width + (40px * S.k);
                        border-radius: (31px * S.k);
                        background: root.zone == Zone.sort ? #ffffff26 : #ffffff14;
                        border-width: root.zone == Zone.sort ? (3px * S.k) : (1px * S.k);
                        border-color: root.zone == Zone.sort ? #ffffff : Theme.line;
                        sort-row := HorizontalLayout {
                            spacing: (10px * S.k);
                            alignment: center;
                            Text { text: root.sort-label; font-size: (20px * root.library-type-scale); color: Theme.text; vertical-alignment: center; }
                            Image { source: Icons.chevd; colorize: Theme.text3; width: (20px * S.k); height: (20px * S.k); y: (parent.height - (20px * S.k)) / 2; }
                        }
                        TouchArea { mouse-cursor: pointer; clicked => { root.click(Zone.sort, 0); } }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    density := Rectangle {
                        width: density-row.preferred-width;
                        border-radius: (31px * S.k); background: #ffffff0b; border-width: 1px; border-color: Theme.line;
                        density-row := HorizontalLayout {
                            padding: (5px * S.k); spacing: (4px * S.k);
                            for label[i] in [root.width < 1000px ? "Roomy" : "Comfortable", "Compact"]: Rectangle {
                                width: dt.preferred-width + (28px * S.k);
                                border-radius: (26px * S.k);
                                property <bool> chosen: root.library-compact == (i == 1);
                                background: chosen ? #ffffff20 : transparent;
                                border-width: root.zone == Zone.density && root.idx == i && root.overlay == 0 ? (2px * S.k) : 0;
                                border-color: Theme.ring;
                                dt := Text { text: label; font-size: (17px * root.library-type-scale); color: chosen ? Theme.text : Theme.text3; vertical-alignment: center; }
                                TouchArea { mouse-cursor: pointer; clicked => { root.click(Zone.density, i); } }
                            }
                        }
                    }
                }
                Rectangle {
                    x: (96px * S.k);
                    y: (192px * S.k);
                    width: root.width - (192px * S.k);
                    height: (52px * S.k);
                    for g in root.status-filters: LibraryFilter {
                        x: g.x; y: (4px * S.k); data: g; type-scale: root.library-type-scale;
                        focused: root.zone == Zone.chips && root.idx == g.index && root.overlay == 0;
                        clicked => { root.click(Zone.chips, g.index); }
                    }
                    // The result count, only where it fits beside the chips (narrow windows drop it).
                    Rectangle {
                        x: parent.width - self.width; width: max(count.preferred-width, snapshot.preferred-width);
                        visible: root.status-filters-end + (24px * S.k) <= self.x;
                        VerticalLayout {
                            alignment: center; spacing: (3px * S.k);
                            count := Text { text: root.count-label; font-size: (18px * root.library-type-scale); color: Theme.text2; horizontal-alignment: right; }
                            snapshot := Text { text: root.peer-snapshot-label; font-size: (14px * root.library-type-scale); color: Theme.text3; horizontal-alignment: right; }
                        }
                    }
                }
                Rectangle {
                    x: (96px * S.k); y: (254px * S.k); width: root.width - (192px * S.k);
                    height: (52px * S.k);
                    Text { x: 0; y: 0; height: parent.height; text: "GENRE"; font-size: (14px * root.library-type-scale); font-weight: 600; color: Theme.text3; width: (76px * S.k); horizontal-alignment: left; vertical-alignment: center; }
                    Rectangle {
                        x: (80px * S.k); y: (6px * S.k); width: (36px * S.k); height: (36px * S.k);
                        border-radius: (18px * S.k); background: root.genres-x < 0 ? #ffffff14 : transparent;
                        Image { source: Icons.chevl; colorize: root.genres-x < 0 ? Theme.text : Theme.text3; width: (20px * S.k); height: (20px * S.k); }
                        TouchArea { enabled: root.genres-x < 0; mouse-cursor: pointer; clicked => { root.genres-scroll(-3); } }
                    }
                    Flickable {
                        x: (124px * S.k); width: parent.width - (168px * S.k); height: parent.height;
                        content-x: root.genres-x; interactive: false;
                        for g in root.genres: LibraryFilter {
                            x: g.x; y: (4px * S.k); data: g; type-scale: root.library-type-scale;
                            focused: root.zone == Zone.chips && root.idx == g.index && root.overlay == 0;
                            clicked => { root.click(Zone.chips, g.index); }
                        }
                    }
                    // Chips scrolled past either edge fade out instead of being sliced off.
                    if root.genres-x < 0: Rectangle {
                        x: (124px * S.k); width: (48px * S.k); height: parent.height;
                        background: @linear-gradient(90deg, #070a14, #070a1400);
                    }
                    if root.genres-more-right: Rectangle {
                        x: parent.width - (92px * S.k); width: (48px * S.k); height: parent.height;
                        background: @linear-gradient(90deg, #070a1400, #070a14);
                    }
                    Rectangle {
                        x: parent.width - (36px * S.k); y: (6px * S.k); width: (36px * S.k); height: (36px * S.k);
                        border-radius: (18px * S.k); background: root.genres-more-right ? #ffffff14 : transparent;
                        Image { source: Icons.chevr; colorize: root.genres-more-right ? Theme.text : Theme.text3; width: (20px * S.k); height: (20px * S.k); }
                        TouchArea { enabled: root.genres-more-right; mouse-cursor: pointer; clicked => { root.genres-scroll(3); } }
                    }
                }
            }
        }

        // ------------------------------------------------------------ TOP BAR
        Rectangle {
            y: 0;
            height: (104px * S.k);
            HorizontalLayout {
                x: (96px * S.k);
                y: 0;
                height: (104px * S.k);
                spacing: (44px * S.k);
                alignment: start;
                for tab[i] in ["Home", "Library"]: Rectangle {
                    width: tt.preferred-width + (8px * S.k);
                    property <bool> active: root.view == i;
                    property <bool> f: root.zone == Zone.tabs && root.idx == i && root.overlay == 0;
                    tt := Text {
                        text: tab;
                        font-size: (30px * S.k);
                        font-weight: 500;
                        color: active || f ? Theme.text : Theme.text3;
                        animate color { duration: Theme.fast; }
                    }
                    Rectangle {
                        y: parent.height / 2 + (28px * S.k);
                        width: active ? (28px * S.k) : 0;
                        height: (3px * S.k);
                        border-radius: (2px * S.k);
                        background: #ffffff;
                        animate width { duration: Theme.move; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
                    }
                    Rectangle {
                        visible: f;
                        x: -(14px * S.k);
                        width: parent.width + (28px * S.k);
                        y: parent.height / 2 - (26px * S.k);
                        height: (52px * S.k);
                        border-radius: (26px * S.k);
                        border-width: (3px * S.k);
                        border-color: #ffffff;
                    }
                    TouchArea { mouse-cursor: pointer; clicked => { root.click(Zone.tabs, i); } }
                }
            }
            HorizontalLayout {
                x: root.width - self.width - (96px * S.k);
                y: 0;
                width: self.preferred-width;
                height: (104px * S.k);
                spacing: (22px * S.k);
                if root.running.active: Rectangle {
                    height: (52px * S.k);
                    y: (26px * S.k);
                    width: pill.preferred-width;
                    border-radius: (26px * S.k);
                    background: #3ddc9724;
                    border-width: 1px;
                    border-color: #3ddc975a;
                    pill := HorizontalLayout {
                        padding-left: (18px * S.k);
                        padding-right: (8px * S.k);
                        spacing: (12px * S.k);
                        Rectangle { width: (10px * S.k); height: (10px * S.k); y: (21px * S.k); border-radius: (5px * S.k); background: Theme.ok; }
                        Text { text: root.running.name; font-size: (18px * S.k); font-weight: 600; color: Theme.text; vertical-alignment: center; }
                        Text { text: root.running.time; font-size: (18px * S.k); color: Theme.text2; vertical-alignment: center; }
                        for b[i] in ["Resume", "Stop"]: Rectangle {
                            y: (7px * S.k);
                            height: (38px * S.k);
                            width: bt.preferred-width + (28px * S.k);
                            border-radius: (19px * S.k);
                            property <bool> f: root.zone == Zone.top && root.idx == i && root.overlay == 0;
                            background: f ? (i == 1 ? Theme.danger : #ffffff) : #ffffff1f;
                            bt := Text { text: b; font-size: (16px * S.k); font-weight: 600; color: f && i == 0 ? #0a0d18 : #ffffff; }
                            TouchArea { mouse-cursor: pointer; clicked => { root.click(Zone.top, i); } }
                        }
                    }
                }
                if root.download-active || root.install-active: Rectangle {
                    width: (230px * S.k); height: (52px * S.k); y: (26px * S.k);
                    border-radius: (12px * S.k); background: #0a6cff26;
                    Text { text: root.install-active ? root.install-badge : root.download-badge; font-size: (17px * S.k); color: #a7caff; y: (8px * S.k); height: (24px * S.k); }
                    Rectangle {
                        x: (14px * S.k); y: (39px * S.k); width: parent.width - (28px * S.k); height: (4px * S.k); background: #ffffff14;
                        Rectangle { x: 0; y: 0; width: parent.width * (root.install-active ? root.install-progress : root.download-progress); background: Theme.accent; animate width { duration: 300ms; } }
                    }
                    TouchArea { mouse-cursor: pointer; clicked => { root.click(Zone.top, 4); } }
                }
                for ic[i] in [Icons.search, Icons.gear, Icons.disk]: Rectangle {
                    width: (52px * S.k);
                    height: (52px * S.k);
                    y: (26px * S.k);
                    border-radius: (26px * S.k);
                    property <bool> f: root.zone == Zone.top && root.idx == i + 2 && root.overlay == 0;
                    background: f ? #ffffff : ta.has-hover ? #ffffff14 : transparent;
                    Image { source: ic; colorize: f ? #0a0d18 : Theme.text2; width: (26px * S.k); height: (26px * S.k); }
                    ta := TouchArea { mouse-cursor: pointer; clicked => { root.click(Zone.top, i + 2); } }
                }
                Text {
                    text: root.clock;
                    font-size: (26px * S.k);
                    color: Theme.text;
                    vertical-alignment: center;
                    min-width: (80px * S.k);
                    horizontal-alignment: right;
                }
            }
        }

        // ------------------------------------------------------------ status + hints
        // Background work (downloads, updates): a small pill on the Home screen only, so it never
        // sits on top of Library titles or panels.
        if root.status != "" && root.view == 0 && root.overlay == 0: Rectangle {
            x: (76px * S.k);
            y: root.height - self.height - (30px * S.k);
            width: status-row.preferred-width;
            height: (50px * S.k);
            border-radius: (25px * S.k);
            background: #070a14e6;
            border-width: 1px;
            border-color: Theme.line;
            status-row := HorizontalLayout {
                padding-left: (18px * S.k);
                padding-right: (20px * S.k);
                spacing: (10px * S.k);
                if root.status-busy: Image {
                    source: Icons.spinner;
                    width: (18px * S.k);
                    height: (18px * S.k);
                    y: (16px * S.k);
                    transform-rotation: animation-tick() / 1ms * 0.4deg;
                }
                Text { text: root.status; font-size: (16px * S.k); color: Theme.text2; vertical-alignment: center; }
            }
        }
        Rectangle {
            x: root.width - self.width - (76px * S.k);
            y: root.height - self.height - (30px * S.k);
            width: hints.preferred-width;
            height: (50px * S.k);
            border-radius: (25px * S.k);
            background: #070a14e6;
            border-width: 1px;
            border-color: Theme.line;
            // Hidden over the library grid so it never covers game titles.
            visible: root.overlay != 4 && root.overlay != 3 && root.overlay != 6 && root.overlay != 7 && (root.view == 0 || root.overlay != 0);
            hints := HorizontalLayout {
                padding-left: (20px * S.k);
                padding-right: (22px * S.k);
                spacing: (24px * S.k);
                alignment: center;
                // Only keys that do something on the current screen.
                for h in root.overlay == 0 && !root.home-has-game
                    ? (root.pad-hints ? [{k: "✕", l: "Select", c: #8fb6ff, r: true}] : [{k: "Enter", l: "Select", c: #ffffff, r: false}])
                    : root.overlay == 0
                    ? (root.pad-hints
                        ? [{k: "✕", l: "Select", c: #8fb6ff, r: true}, {k: "□", l: "Trailer", c: #f5a3e6, r: true}, {k: "△", l: "Search", c: #6ee7c8, r: true}, {k: "☰", l: "Options", c: #ffffff, r: false}]
                        : [{k: "Enter", l: "Select", c: #ffffff, r: false}, {k: "T", l: "Trailer", c: #ffffff, r: false}, {k: "/", l: "Search", c: #ffffff, r: false}, {k: "O", l: "Options", c: #ffffff, r: false}])
                    : root.overlay == 1
                    ? (root.pad-hints
                        ? [{k: "✕", l: "Select", c: #8fb6ff, r: true}, {k: "○", l: "Back", c: #ff8f9c, r: true}, {k: "□", l: "Trailer", c: #f5a3e6, r: true}, {k: "☰", l: "Options", c: #ffffff, r: false}]
                        : [{k: "Enter", l: "Select", c: #ffffff, r: false}, {k: "Esc", l: "Back", c: #ffffff, r: false}, {k: "T", l: "Trailer", c: #ffffff, r: false}, {k: "O", l: "Options", c: #ffffff, r: false}])
                    : (root.pad-hints
                        ? [{k: "✕", l: "Select", c: #8fb6ff, r: true}, {k: "○", l: "Back", c: #ff8f9c, r: true}]
                        : [{k: "Enter", l: "Select", c: #ffffff, r: false}, {k: "Esc", l: "Back", c: #ffffff, r: false}])
                    : HorizontalLayout {
                        spacing: (10px * S.k);
                        KeyCap { text: h.k; round: h.r; fg: h.c; y: (10px * S.k); }
                        Text { text: h.l; font-size: (17px * S.k); color: Theme.text2; vertical-alignment: center; }
                    }
            }
        }

        // ------------------------------------------------------------ GAME HUB
        if root.overlay == 1 || root.hub-open: Rectangle {
            background: Theme.bg;
            property <bool> entered: false;
            init => { entered = true; }
            opacity: entered ? 1 : 0;
            animate opacity { duration: 240ms; easing: ease-out-quad; }
            Image {
                source: root.bg-show-b ? root.bg-b : root.bg-a;
                width: root.width;
                height: root.height;
                image-fit: cover;
            }
            // Dark enough behind the text column for long descriptions over busy art.
            Rectangle { background: @linear-gradient(90deg, #04060ef7 0%, #04060ee8 50%, #04060ea6 72%, #04060e40 100%); }
            Rectangle { background: @linear-gradient(0deg, #04060ee6 0%, #04060e00 50%); }

            Rectangle {
                x: (96px * S.k);
                y: (130px * S.k);
                width: (380px * S.k);
                height: (570px * S.k);   // 2:3, like the official covers
                border-radius: (20px * S.k);
                clip: true;
                background: Theme.panel;
                drop-shadow-blur: 0;
                Cover { source: root.hub.cover; loaded: root.hub.cover-loaded; }
                // No artwork: the console's colours, as on the Library card (the name is beside it).
                if root.hub.no-art: Rectangle {
                    background: root.hub.console == "PC" ? @linear-gradient(160deg, #1d3a2f 0%, #0d1714 100%)
                        : root.hub.console == "PS4" ? @linear-gradient(160deg, #1b2d52 0%, #0b1224 100%)
                        : @linear-gradient(160deg, #26304f 0%, #0e1222 100%);
                    Text {
                        text: root.hub.console;
                        font-size: (64px * S.k);
                        font-weight: 800;
                        color: #ffffff2e;
                    }
                }
            }
            // Scroll areas crop their content, so they start `gutter` before the content: a selected
            // button's grow + glow must never be cut off at the edge.
            hub-flick := Flickable {
                property <length> col-h: hub-col.height;
                init => { root.hub-content-h = self.content-height; root.hub-col-h = self.col-h; }
                changed content-height => { root.hub-content-h = self.content-height; }
                changed col-h => { root.hub-col-h = self.col-h; }
                property <length> gutter: (40px * S.k);
                x: (540px * S.k) - self.gutter;
                width: root.width - (540px * S.k) - (60px * S.k) + self.gutter;
                height: root.height;
                content-y <=> root.hub-y;
                content-height: hub-col.preferred-height + (200px * S.k);
                hub-col := VerticalLayout {
                    x: parent.gutter;
                    y: 0;
                    width: min((1060px * S.k), root.width - (540px * S.k) - (96px * S.k));
                    height: self.preferred-height;
                    padding-top: (130px * S.k);
                    spacing: 0;
                    if root.hub.kicker != "" || root.hub.kicker-accent != "": Kicker { text: root.hub.kicker; accent: root.hub.kicker-accent; live: root.hub.kicker-live; }
                    if root.hub.kicker != "" || root.hub.kicker-accent != "": Rectangle { height: (16px * S.k); }
                    if root.hub.has-logo: Image {
                        source: root.hub.logo;
                        width: root.hub.logo-w;
                        height: root.hub.logo-h;
                        image-fit: contain;
                    }
                    if !root.hub.has-logo: Text {
                        text: root.hub.title;
                        font-size: (72px * S.k);
                        font-weight: 700;
                        color: Theme.text;
                        width: root.hub-text-w;
                        wrap: word-wrap;
                    }
                    Rectangle { height: (22px * S.k); }
                    if root.hub.subtitle != "": Text { text: root.hub.subtitle; font-size: (20px * S.k); color: Theme.text2; wrap: word-wrap; }
                    if root.hub.subtitle != "": Rectangle { height: (16px * S.k); }
                    HorizontalLayout {
                        spacing: (10px * S.k);
                        alignment: start;
                        for c in root.hub.chips: Chip { data: c; }
                    }
                    Rectangle { height: (30px * S.k); }
                    HorizontalLayout {
                        spacing: (16px * S.k);
                        alignment: start;
                        for a[i] in root.hub.actions: Btn {
                            data: a;
                            focused: root.zone == Zone.hub && root.idx == i && root.overlay == 1;
                            dim: root.zone == Zone.hub && root.idx != i && root.overlay == 1;
                            clicked => { root.click(Zone.hub, i); }
                        }
                    }
                    Rectangle { height: (22px * S.k); }
                    if root.hub.release-count > 1: Rectangle {
                        height: (54px * S.k); border-radius: (12px * S.k); background: #ffffff0d;
                        border-width: root.zone == Zone.releases ? (2px * S.k) : 1px;
                        border-color: root.zone == Zone.releases ? Theme.text : Theme.line;
                        HorizontalLayout {
                            spacing: (12px * S.k); padding-left: (14px * S.k); padding-right: (14px * S.k);
                            Rectangle {
                                width: (44px * S.k);
                                Text { text: "‹"; font-size: (30px * S.k); color: Theme.text; }
                                TouchArea { mouse-cursor: pointer; clicked => { root.hub-release(-1); } }
                            }
                            Text { text: root.hub.release-label; font-size: (18px * S.k); color: Theme.text2; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                            Rectangle {
                                width: (44px * S.k);
                                Text { text: "›"; font-size: (30px * S.k); color: Theme.text; }
                                TouchArea { mouse-cursor: pointer; clicked => { root.hub-release(1); } }
                            }
                        }
                    }
                    if root.hub.peer-status != "": HorizontalLayout {
                        padding-top: (16px * S.k); padding-bottom: (22px * S.k); spacing: (10px * S.k); alignment: start;
                        Image { source: Icons.user; colorize: Theme.text3; width: (18px * S.k); height: (18px * S.k); }
                        Text { text: "↑ " + root.hub.seeders + " seeders"; font-size: (18px * S.k); font-weight: 600; color: root.hub.seeders == "—" ? Theme.text3 : Theme.ok; }
                        Text { text: "↓ " + root.hub.leechers + " leechers"; font-size: (18px * S.k); font-weight: 600; color: root.hub.leechers == "—" ? Theme.text3 : Theme.danger; }
                        Text { text: "·  " + root.hub.peer-snapshot; font-size: (17px * S.k); color: Theme.text3; wrap: word-wrap; }
                    }
                    for fr in root.hub.facts: HorizontalLayout {
                        spacing: (14px * S.k);
                        padding-bottom: (14px * S.k);
                        for f in fr.items: Rectangle {
                            width: (min((1060px * S.k), root.width - (540px * S.k) - (96px * S.k)) - (28px * S.k)) / 3;
                            height: (92px * S.k);
                            border-radius: (16px * S.k);
                            background: #0b1020b8;
                            border-width: 1px;
                            border-color: Theme.line;
                            VerticalLayout {
                                padding-left: (22px * S.k);
                                padding-right: (16px * S.k);
                                alignment: center;
                                spacing: (6px * S.k);
                                Text { text: f.key; font-size: (15px * S.k); font-weight: 600; letter-spacing: (1.5px * S.k); color: Theme.text3; }
                                Text { text: f.value; font-size: (21px * S.k); font-weight: 500; overflow: elide;
                                    color: f.kind == 1 ? Theme.ok : f.kind == 2 ? Theme.warn : f.kind == 3 ? Theme.danger : Theme.text; }
                            }
                        }
                    }
                    Rectangle {
                        height: (46px * S.k); border-radius: (10px * S.k);
                        background: root.zone == Zone.hub-details ? #ffffff1f : #ffffff08;
                        border-width: root.zone == Zone.hub-details ? (2px * S.k) : 1px;
                        border-color: root.zone == Zone.hub-details ? Theme.text : Theme.line;
                        Text { text: root.hub-details-open ? "−  Hide technical details" : "+  Technical details & installed game"; font-size: (18px * S.k); color: Theme.text2; }
                        TouchArea { mouse-cursor: pointer; clicked => { root.click(Zone.hub-details, 0); } }
                    }
                    if root.hub-details-open: VerticalLayout {
                        padding-top: (16px * S.k); spacing: (10px * S.k);
                        for fr in root.hub.details: VerticalLayout {
                            spacing: (10px * S.k);
                            for f in fr.items: HorizontalLayout {
                                spacing: (18px * S.k);
                                Text { text: f.key; width: (260px * S.k); font-size: (16px * S.k); color: Theme.text3; }
                                Text { text: f.value; font-size: (18px * S.k); color: Theme.text2; wrap: word-wrap; horizontal-stretch: 1; }
                            }
                        }
                    }
                    if root.hub.shots.length > 0: VerticalLayout {
                        padding-top: (22px * S.k);
                        spacing: (14px * S.k);
                        Text { text: "SCREENSHOTS"; font-size: (18px * S.k); font-weight: 600; letter-spacing: (2px * S.k); color: Theme.text3; }
                        Rectangle {
                        height: (192px * S.k);
                        Flickable {
                            // Overhangs the column by a gutter on each side so rings/glows aren't cut.
                            x: -(30px * S.k);
                            width: parent.width + (60px * S.k);
                            height: parent.height;
                            interactive: false;
                            content-x: root.shots-x;
                            content-width: root.hub.shots.length * (314px * S.k) + (72px * S.k);
                            for s[i] in root.hub.shots: Rectangle {
                                x: (30px * S.k) + i * (314px * S.k);
                                y: (12px * S.k);
                                width: (300px * S.k);
                                height: (169px * S.k);
                                FocusRing { w: parent.width; h: parent.height; on: root.zone == Zone.shots && root.idx == i && root.overlay == 1; radius: (12px * S.k); }
                                Rectangle {
                                    border-radius: (12px * S.k);
                                    clip: true;
                                    background: Theme.panel;
                                    Shimmer { active: !s.loaded; }
                                    Image {
                                        source: s.image;
                                        width: parent.width;
                                        height: parent.height;
                                        image-fit: cover;
                                        opacity: s.loaded ? 1 : 0;
                                        animate opacity { duration: 250ms; }
                                    }
                                }
                                TouchArea { mouse-cursor: pointer; clicked => { root.click(Zone.shots, i); } }
                            }
                        }
                        }
                    }
                    if root.hub.about.length > 0: VerticalLayout {
                        padding-top: (30px * S.k);
                        spacing: (16px * S.k);
                        Text { text: "ABOUT"; font-size: (18px * S.k); font-weight: 600; letter-spacing: (2px * S.k); color: root.zone == Zone.desc ? Theme.text : Theme.text3; }
                        for p in root.hub.about: Text {
                            // Explicit width: wrapped text inside a nested block is otherwise measured
                            // unwrapped (one line), which made the page too short to scroll to the end.
                            width: root.hub-text-w;
                            text: p;
                            font-size: (21px * S.k);
                            color: Theme.text2;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }

        if root.overlay == 1: BackButton {
            x: (96px * S.k);
            y: (44px * S.k);
            pad: root.pad-hints;
            clicked => { root.click(Zone.hub, -1); }
        }

        // ------------------------------------------------------------ SETTINGS
        if root.overlay == 2: Rectangle {
            property <bool> entered: false;
            init => { entered = true; }
            background: entered ? #03050ccc : #03050c00;
            animate background { duration: 260ms; }
            TouchArea { clicked => { root.click(Zone.settings, -1); } }
            Rectangle {
                // Sized by the text scale, so on a small window the panel grows with its text
                // (and wraps it as at full size) instead of squeezing it.
                property <length> panel-width: min(root.width, (760px * S.t));
                x: root.width - self.panel-width + (entered ? 0 : (120px * S.k));
                opacity: entered ? 1 : 0;
                animate x { duration: 420ms; easing: ease-out-expo; }
                animate opacity { duration: 220ms; easing: ease-out-quad; }
                width: self.panel-width;
                background: @linear-gradient(180deg, #111a33 0%, #0a1024 100%);
                border-width: 1px;
                border-color: Theme.line;
                TouchArea {}
                Flickable {
                    content-y <=> root.settings-y;
                    content-height: sheet.preferred-height;
                    sheet := VerticalLayout {
                        x: 0;
                        y: 0;
                        width: parent.width;
                        height: self.preferred-height;
                        padding-left: (56px * S.k);
                        padding-right: (56px * S.k);
                        padding-top: (64px * S.k);
                        padding-bottom: (120px * S.k);
                        spacing: 0;
                        HorizontalLayout {
                            alignment: start;
                            padding-bottom: (20px * S.k);
                            BackButton { pad: root.pad-hints; clicked => { root.click(Zone.settings, -1); } }
                        }
                        Text { text: "Settings"; font-size: (44px * S.k); font-weight: 600; color: Theme.text; }
                        Text { text: "Changes are saved automatically"; font-size: (18px * S.t); color: Theme.text3; }
                        for s[i] in root.settings: VerticalLayout {
                            property <bool> f: root.zone == Zone.settings && root.idx == i;
                            property <length> r: (14px * S.k);
                            padding-top: s.kind == 0 ? (s.label == "" ? (20px * S.k) : (36px * S.k)) : 0;
                            padding-bottom: s.kind == 0 ? (12px * S.k) : 0;
                            if s.kind == 0 && s.label != "": Text { text: s.label; font-size: (16px * S.t); font-weight: 600; letter-spacing: (2px * S.k); color: Theme.text3; }
                            // One row of a section card: rows between two headers share a card.
                            if s.kind != 0: Rectangle {
                                background: f ? (s.danger ? #ff5a6a33 : #ffffff1f) : (s.danger ? #ff5a6a0d : #ffffff0b);
                                border-top-left-radius: s.group-first || f ? r : 0;
                                border-top-right-radius: s.group-first || f ? r : 0;
                                border-bottom-left-radius: s.group-last || f ? r : 0;
                                border-bottom-right-radius: s.group-last || f ? r : 0;
                                border-width: f ? (3px * S.k) : 0;
                                border-color: s.danger ? Theme.danger : #ffffff;
                                if !s.group-first && !f && !(root.zone == Zone.settings && root.idx == i - 1): Rectangle {
                                    x: (18px * S.k);
                                    y: 0;
                                    width: parent.width - (36px * S.k);
                                    height: 1px;
                                    background: Theme.line;
                                }
                                TouchArea { mouse-cursor: pointer; clicked => { root.click(Zone.settings, i); } }
                                VerticalLayout {
                                    padding-left: (18px * S.k);
                                    padding-right: (18px * S.k);
                                    padding-top: (14px * S.k);
                                    padding-bottom: (14px * S.k);
                                    spacing: (4px * S.k);
                                    HorizontalLayout {
                                        spacing: (16px * S.k);
                                        min-height: (36px * S.k);
                                        Text {
                                            text: s.label;
                                            font-size: (19px * S.t);
                                            font-weight: s.kind == 4 ? 600 : 500;
                                            color: s.danger ? #ffb3bb : Theme.text;
                                            vertical-alignment: center;
                                            horizontal-stretch: s.kind == 1 ? 0 : 1;
                                            // Never push the switch or value off the card.
                                            overflow: elide;
                                        }
                                        if s.kind == 1 && root.edit-index != i: Text {
                                            text: s.value != "" ? s.value : (s.secret ? "Not set" : "—");
                                            font-size: (17px * S.t);
                                            font-family: "DejaVu Sans Mono";
                                            color: s.value != "" ? Theme.text2 : Theme.text3;
                                            horizontal-alignment: right;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                            min-width: (120px * S.k);
                                            overflow: elide;
                                        }
                                        if s.kind == 2: VerticalLayout { alignment: center; Switch { on: s.on; } }
                                        if s.kind == 3: HorizontalLayout {
                                            spacing: (8px * S.k);
                                            alignment: end;
                                            Image { source: Icons.chevl; colorize: f ? Theme.text : Theme.text3; width: (22px * S.k); height: (22px * S.k); y: (7px * S.k); }
                                            Text { text: s.value; font-size: (19px * S.t); color: Theme.text; vertical-alignment: center; }
                                            Image { source: Icons.chevr; colorize: f ? Theme.text : Theme.text3; width: (22px * S.k); height: (22px * S.k); y: (7px * S.k); }
                                        }
                                        if s.kind == 4 && s.value != "": Text {
                                            text: s.value;
                                            font-size: (17px * S.t);
                                            font-weight: s.value-kind == 3 ? 600 : 400;
                                            color: s.value-kind == 1 ? Theme.ok : s.value-kind == 2 ? Theme.danger : s.value-kind == 3 ? #7ab4ff : Theme.text3;
                                            vertical-alignment: center;
                                        }
                                    }
                                    if s.kind == 1 && root.edit-index == i: Rectangle {
                                        height: (50px * S.t);
                                        border-radius: (10px * S.k);
                                        background: #00000040;
                                        border-width: 1px;
                                        border-color: Theme.line;
                                        TextInput {
                                            x: (14px * S.k);
                                            width: parent.width - (28px * S.k);
                                            height: parent.height;
                                            text <=> root.edit-text;
                                            single-line: true;
                                            input-type: s.secret ? InputType.password : InputType.text;
                                            font-size: (18px * S.t);
                                            color: Theme.text;
                                            vertical-alignment: center;
                                            font-family: "DejaVu Sans Mono";
                                            init => { self.focus(); self.select-all(); }
                                            accepted => { root.edit-done(self.text, true); }
                                        }
                                    }
                                    if s.hint != "": Text {
                                        text: s.hint;
                                        font-size: (15px * S.t);
                                        wrap: word-wrap;
                                        color: s.hint-kind == 1 ? Theme.ok : s.hint-kind == 2 ? Theme.danger : Theme.text3;
                                    }
                                }
                            }
                        }
                        // About: required attribution for the Slint royalty-free license (section 2a).
                        VerticalLayout {
                            padding-top: (36px * S.k);
                            spacing: (12px * S.k);
                            Text { text: "ABOUT"; font-size: (16px * S.t); font-weight: 600; letter-spacing: (2px * S.k); color: Theme.text3; }
                            Rectangle {
                                border-radius: (14px * S.k);
                                background: #ffffff0b;
                                HorizontalLayout {
                                    padding-left: (18px * S.k);
                                    padding-right: (10px * S.k);
                                    padding-top: (14px * S.k);
                                    padding-bottom: (14px * S.k);
                                    spacing: (16px * S.k);
                                    VerticalLayout {
                                        alignment: center;
                                        Image { source: Icons.app; width: (60px * S.k); height: (60px * S.k); }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        spacing: (4px * S.k);
                                        horizontal-stretch: 1;
                                        Text { text: "Azrak Launcher"; font-size: (19px * S.t); font-weight: 600; color: Theme.text; }
                                        Text { text: "Version " + root.app-version + " · Linux"; font-size: (15px * S.t); color: Theme.text3; }
                                        Text { text: "PS5 games on KytyPS5 · PS4 games on shadPS4"; font-size: (15px * S.t); color: Theme.text3; }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        AboutSlint { width: (190px * S.k); }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // ------------------------------------------------------------ BACKGROUND DOWNLOADS
        if root.overlay == 8: LibrarySortPicker {
            options: root.sort-options; selected: root.idx; current: root.sort-selected;
            type-scale: root.library-type-scale; anchor-x: root.library-sort-anchor;
            choose(index) => { root.click(Zone.sort-picker, index); }
            close => { root.click(Zone.sort-picker, -1); }
        }
        if root.overlay == 7 && !root.download-consent: DownloadsSheet {
            data: root.downloads; summary: root.download-summary; selected: root.idx;
            scroll-y <=> root.downloads-y;
            action(key, action) => { root.download-action(key, action); }
            close => { root.download-close(); }
        }
        if root.overlay == 7 && root.download-consent: DownloadConsent {
            focus-path: root.download-focus-path;
            install: root.download-is-install;
            title: root.download-title; error: root.download-error; privacy: root.download-privacy; install-note: root.download-install-note; warning: root.download-warning;
            destination <=> root.download-path;
            confirm => { root.download-confirm(); }
            close => { root.download-close(); }
            edit-done => { root.focus-root(); }
            editing(focused) => { root.download-editing = focused; root.download-focus-path = false; }
        }

        // ------------------------------------------------------------ SCREENSHOT VIEWER
        if root.overlay == 3: Rectangle {
            property <bool> entered: false;
            init => { entered = true; }
            opacity: entered ? 1 : 0;
            animate opacity { duration: 200ms; easing: ease-out-quad; }
            background: #000000f2;
            Image {
                x: (48px * S.k);
                y: (104px * S.k);
                width: root.width - (96px * S.k);
                height: root.height - (160px * S.k);
                source: root.viewer-image;
                image-fit: contain;
            }
            Rectangle {
                x: root.width - self.width - (48px * S.k);
                y: root.height - self.height - (36px * S.k);
                width: vc.preferred-width + (28px * S.k);
                height: (36px * S.k);
                border-radius: (18px * S.k);
                background: #000000b3;
                vc := Text { text: root.viewer-count + "   ◂ ▸ to browse · Esc to close"; font-size: (16px * S.k); color: Theme.text2; }
            }
            TouchArea { clicked => { root.click(Zone.shots, -1); } }
            BackButton {
                x: (48px * S.k);
                y: (36px * S.k);
                pad: root.pad-hints;
                clicked => { root.click(Zone.shots, -1); }
            }
        }

        // ------------------------------------------------------------ OPTIONS MENU
        if root.overlay == 5: Rectangle {
            property <bool> entered: false;
            init => { entered = true; }
            background: entered ? #03050c99 : #03050c00;
            animate background { duration: 200ms; }
            TouchArea { clicked => { root.click(Zone.menu, -1); } }
            Rectangle {
                x: (root.width - self.width) / 2;
                y: (root.height - self.height) / 2;
                opacity: entered ? 1 : 0;
                transform-scale: entered ? 1.0 : 0.94;
                animate opacity { duration: 180ms; easing: ease-out-quad; }
                animate transform-scale { duration: 320ms; easing: ease-out-back; }
                width: (520px * S.k);
                height: menu-col.preferred-height;
                border-radius: (22px * S.k);
                background: #121a31fa;
                border-width: 1px;
                border-color: Theme.line;
                drop-shadow-blur: (40px * S.k);
                drop-shadow-color: #00000099;
                TouchArea {}
                menu-col := VerticalLayout {
                    padding: (18px * S.k);
                    spacing: (6px * S.k);
                    Text {
                        text: root.menu-title;
                        font-size: (20px * S.k);
                        font-weight: 600;
                        color: Theme.text2;
                        overflow: elide;
                        horizontal-alignment: left;
                    }
                    Rectangle { height: (6px * S.k); }
                    for m[i] in root.menu-items: Rectangle {
                        height: (58px * S.k);
                        border-radius: (12px * S.k);
                        property <bool> f: root.zone == Zone.menu && root.idx == i;
                        background: f ? #ffffff : transparent;
                        HorizontalLayout {
                            padding-left: (18px * S.k);
                            padding-right: (18px * S.k);
                            spacing: (16px * S.k);
                            Image { source: Icons.get(m.icon); colorize: f ? #0a0d18 : Theme.text2; width: (24px * S.k); height: (24px * S.k); y: (17px * S.k); }
                            // Long labels (a game's file names) stay inside the menu.
                            Text { text: m.label; font-size: (20px * S.k); color: f ? #0a0d18 : Theme.text; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; min-width: 0; }
                        }
                        TouchArea { mouse-cursor: pointer; clicked => { root.click(Zone.menu, i); } }
                    }
                }
            }
        }

        // ------------------------------------------------------------ LAUNCH SPLASH
        if root.overlay == 4: Rectangle {
            property <bool> entered: false;
            init => { entered = true; }
            opacity: entered ? 1 : 0;
            animate opacity { duration: 320ms; easing: ease-out-quad; }
            background: #000000;
            Image {
                source: root.launch-bg;
                width: root.width;
                height: root.height;
                image-fit: cover;
                opacity: 0.45;
            }
            Rectangle { background: @radial-gradient(circle, #00000033 0%, #000000d9 75%); }
            VerticalLayout {
                alignment: center;
                spacing: 0;
                HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        width: (220px * S.k);
                        height: (220px * S.k);
                        border-radius: (28px * S.k);
                        clip: true;
                        background: Theme.panel;
                        Image { source: root.launch-icon; width: parent.width; height: parent.height; image-fit: cover; }
                    }
                }
                Rectangle { height: (34px * S.k); }
                Text { text: root.launch-name; font-size: (44px * S.k); font-weight: 600; color: Theme.text; horizontal-alignment: center; }
                Rectangle { height: (10px * S.k); }
                Text { text: root.launch-sub; font-size: (20px * S.k); color: Theme.text2; horizontal-alignment: center; }
                Rectangle { height: (36px * S.k); }
                HorizontalLayout {
                    alignment: center;
                    Image {
                        source: Icons.spinner;
                        width: (44px * S.k);
                        height: (44px * S.k);
                        transform-rotation: animation-tick() / 1ms * 0.4deg;
                    }
                }
                Rectangle { height: (40px * S.k); }
                if !root.launch-keyboard: Text { text: root.launch-controller; font-size: (18px * S.k); color: Theme.ok; horizontal-alignment: center; }
                if root.launch-keyboard: HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        border-radius: (18px * S.k);
                        background: #0b1124e6;
                        border-width: 1px;
                        border-color: Theme.line;
                        VerticalLayout {
                            padding-left: (28px * S.k);
                            padding-right: (28px * S.k);
                            padding-top: (20px * S.k);
                            padding-bottom: (20px * S.k);
                            spacing: (14px * S.k);
                            Text { text: "No controller connected: you'll play with the keyboard."; font-size: (18px * S.k); font-weight: 600; color: Theme.text; horizontal-alignment: center; }
                            Text { text: "Games play best with a controller. Connect one before starting a game."; font-size: (16px * S.k); color: Theme.text2; horizontal-alignment: center; }
                            HorizontalLayout {
                                alignment: center;
                                height: (30px * S.k);
                                spacing: (8px * S.k);
                                for k in (root.launch-ps4
                                        ? [{ key: "N", what: "✕" }, { key: "C", what: "△" }, { key: "V", what: "□" }, { key: "B", what: "○" },
                                           { key: "W A S D", what: "Move" }, { key: "Arrows", what: "D-pad" }, { key: "Enter", what: "Options" }]
                                        : [{ key: "J", what: "✕" }, { key: "I", what: "△" }, { key: "K", what: "□" }, { key: "L", what: "○" },
                                           { key: "W A S D", what: "Move" }, { key: "Arrows", what: "D-pad" }, { key: "Enter", what: "Options" }]): HorizontalLayout {
                                    spacing: (6px * S.k);
                                    padding-right: (10px * S.k);
                                    KeyCap { text: k.key; }
                                    Text { text: k.what; font-size: (16px * S.k); color: Theme.text2; vertical-alignment: center; }
                                }
                            }
                        }
                    }
                }
            }
        }

        // ------------------------------------------------------------ BOOT / WELCOME
        boot := Rectangle {
            property <bool> shown: root.overlay == 6;
            // Motion clock only runs while the screen is up, so it costs nothing afterwards.
            property <float> t: shown ? animation-tick() / 1ms / 1000 : 0;
            opacity: shown ? 1 : 0;
            visible: self.opacity > 0.01;
            animate opacity { duration: 600ms; easing: ease-in-out-quad; }
            transform-scale: shown ? 1.0 : 1.04;
            animate transform-scale { duration: 700ms; easing: ease-in-quad; }
            background: #05070f;
            TouchArea { clicked => { root.click(Zone.row, -2); } }

            // A slowly drifting wall of the library's covers.
            property <length> cw: (190px * S.k);
            property <length> ch: (285px * S.k);
            property <length> cg: (22px * S.k);
            property <int> cols: ceil(root.width / (cw + cg)) + 1;
            property <int> rows: ceil(root.height / (ch + cg)) + 2;
            Rectangle {
                opacity: root.boot-covers.length > 0 ? 0.30 : 0;
                animate opacity { duration: 1600ms; easing: ease-out-quad; }
                for c in boot.cols: Rectangle {
                    property <float> speed: 14 + mod(c * 7, 11);            // px/s, each column differs
                    property <length> shift: (boot.t * speed * 1px * S.k) + c * (97px * S.k);
                    property <length> loop-h: boot.rows * (boot.ch + boot.cg);
                    x: c * (boot.cw + boot.cg) - (40px * S.k);
                    width: boot.cw;
                    for r in boot.rows: Rectangle {
                        property <int> k: mod(c * 7 + r * 11, max(1, root.boot-covers.length));
                        y: mod(r * (boot.ch + boot.cg) / 1px - shift / 1px, loop-h / 1px) * 1px - boot.ch;
                        height: boot.ch;
                        border-radius: (14px * S.k);
                        clip: true;
                        background: #121a31;
                        if root.boot-covers.length > 0: Image {
                            source: root.boot-covers[k];
                            width: parent.width;
                            height: parent.height;
                            image-fit: cover;
                        }
                    }
                }
            }
            // Vignette + drifting light keep the centre calm and readable.
            Rectangle { background: @radial-gradient(circle, #05070fd9 0%, #05070fa6 45%, #05070f40 100%); }
            Rectangle {
                x: root.width * (0.30 + 0.06 * sin(boot.t * 9deg)) - self.width / 2;
                y: root.height * (0.35 + 0.05 * cos(boot.t * 7deg)) - self.height / 2;
                width: (1100px * S.k);
                height: self.width;
                background: @radial-gradient(circle, #1f4fd13d 0%, #1f4fd100 65%);
            }
            Rectangle {
                x: root.width * (0.70 + 0.05 * cos(boot.t * 8deg)) - self.width / 2;
                y: root.height * (0.62 + 0.06 * sin(boot.t * 6deg)) - self.height / 2;
                width: (1000px * S.k);
                height: self.width;
                background: @radial-gradient(circle, #8b5cf62e 0%, #8b5cf600 65%);
            }

            VerticalLayout {
                alignment: center;
                spacing: 0;
                // Custom chassis emblem, presented calmly rather than as a pulsing play button.
                HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        width: (132px * S.k);
                        height: self.width;
                        Rectangle {
                            x: -(40px * S.k);
                            y: -(40px * S.k);
                            width: parent.width + (80px * S.k);
                            height: self.width;
                            background: @radial-gradient(circle, #3d8bff66 0%, #3d8bff00 68%);
                            opacity: 0.28;
                        }
                        Image { source: Icons.app; width: parent.width; height: parent.height; image-fit: contain; }
                    }
                }
                Rectangle { height: (24px * S.k); }
                Text { text: "AZRAK LAUNCHER"; font-size: (19px * S.k); font-weight: 600; letter-spacing: (3px * S.k); color: Theme.text2; horizontal-alignment: center; }
                Rectangle { height: (18px * S.k); }
                if root.boot-first: Text {
                    text: "Welcome";
                    font-size: (64px * S.k);
                    font-weight: 700;
                    color: Theme.text;
                    horizontal-alignment: center;
                }
                if root.boot-first: Text {
                    text: "Setting up Azrak Launcher";
                    font-size: (23px * S.k);
                    color: Theme.text2;
                    horizontal-alignment: center;
                }
                Rectangle { height: root.boot-first ? (44px * S.k) : (6px * S.k); }

                // Step list (first launch only).
                if root.boot-first: HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        width: (560px * S.k);
                        height: steps.preferred-height;
                        border-radius: (20px * S.k);
                        background: #0b1122cc;
                        border-width: 1px;
                        border-color: #ffffff17;
                        steps := VerticalLayout {
                            padding: (22px * S.k);
                            spacing: (14px * S.k);
                            for st in root.boot-steps: HorizontalLayout {
                                spacing: (14px * S.k);
                                height: (30px * S.k);
                                Rectangle {
                                    width: (26px * S.k);
                                    height: self.width;
                                    y: (2px * S.k);
                                    border-radius: self.width / 2;
                                    background: st.state == 2 ? Theme.ok.with-alpha(0.18) : st.state == 3 ? Theme.danger.with-alpha(0.18) : #ffffff10;
                                    animate background { duration: 300ms; }
                                    if st.state == 2: Image { source: Icons.check; colorize: Theme.ok; width: (16px * S.k); height: self.width; }
                                    if st.state == 3: Image { source: Icons.alert; colorize: Theme.danger; width: (16px * S.k); height: self.width; }
                                    if st.state == 1: Image {
                                        source: Icons.spinner;
                                        width: (18px * S.k);
                                        height: self.width;
                                        transform-rotation: boot.t * 400deg;
                                    }
                                    if st.state == 0: Rectangle {
                                        width: (6px * S.k);
                                        height: self.width;
                                        border-radius: self.width / 2;
                                        background: Theme.text3;
                                    }
                                }
                                Text {
                                    text: st.label;
                                    font-size: (19px * S.k);
                                    font-weight: st.state == 1 ? 600 : 500;
                                    color: st.state == 0 ? Theme.text3 : Theme.text;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }
                                Text {
                                    text: st.detail;
                                    font-size: (17px * S.k);
                                    color: st.state == 2 ? Theme.ok : st.state == 3 ? Theme.danger : Theme.text2;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
                Rectangle { height: root.boot-first ? (28px * S.k) : (4px * S.k); }

                // Progress bar with a moving sheen, and the percentage.
                HorizontalLayout {
                    alignment: center;
                    spacing: (16px * S.k);
                    Rectangle {
                        width: root.boot-first ? (480px * S.k) : (360px * S.k);
                        height: (6px * S.k);
                        y: (10px * S.k);
                        border-radius: (3px * S.k);
                        background: #ffffff1a;
                        clip: true;
                        Rectangle {
                            x: 0;
                            width: parent.width * root.boot-progress;
                            border-radius: (3px * S.k);
                            background: @linear-gradient(90deg, #2f6dff 0%, #6ea8ff 60%, #b4d0ff 100%);
                            animate width { duration: 400ms; easing: ease-out-quart; }
                            drop-shadow-blur: (12px * S.k);
                            drop-shadow-color: #3d8bff99;
                        }
                        Rectangle {
                            x: mod(boot.t * 0.6, 1.4) * parent.width - self.width;
                            width: (120px * S.k);
                            background: @linear-gradient(90deg, #ffffff00 0%, #ffffff55 50%, #ffffff00 100%);
                            visible: root.boot-progress < 1;
                        }
                    }
                    if root.boot-first: Text {
                        text: round(root.boot-progress * 100) + "%";
                        font-size: (18px * S.k);
                        font-weight: 600;
                        color: Theme.text2;
                        min-width: (48px * S.k);
                    }
                }
                Rectangle { height: (16px * S.k); }
                Text {
                    text: root.boot-first ? root.boot-detail : root.boot-status;
                    font-size: (16px * S.k);
                    color: Theme.text3;
                    horizontal-alignment: center;
                }
                Rectangle { height: (40px * S.k); }
                if root.boot-first: HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        height: (64px * S.k);
                        width: prompt.preferred-width + (60px * S.k);
                        border-radius: (32px * S.k);
                        background: root.boot-ready ? #ffffff : #ffffff14;
                        border-width: 1px;
                        border-color: #ffffff2e;
                        drop-shadow-blur: root.boot-ready ? (30px * S.k) + (10px * S.k) * sin(boot.t * 150deg) : 0;
                        drop-shadow-color: #8cb9ffaa;
                        transform-scale: root.boot-ready ? 1.0 : 0.96;
                        animate background { duration: 300ms; }
                        animate transform-scale { duration: 500ms; easing: ease-out-back; }
                        prompt := HorizontalLayout {
                            alignment: center;
                            spacing: (12px * S.k);
                            KeyCap { text: root.pad-hints ? "✕" : "Enter"; round: root.pad-hints; fg: root.boot-ready ? #ffffff : #8fb6ff; bg: root.boot-ready ? #0a0d18 : #ffffff24; y: (17px * S.k); }
                            Text {
                                text: root.boot-ready ? "Start" : "Skip and continue";
                                font-size: (21px * S.k);
                                font-weight: 600;
                                color: root.boot-ready ? #0a0d18 : Theme.text;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }

        // ------------------------------------------------------------ JOIN A WI-FI NETWORK
        if root.overlay == 12: wj := Rectangle {
            property <float> t: animation-tick() / 1ms / 1000;
            property <length> key: (74px * S.k);
            property <length> gap: (10px * S.k);
            background: #03050cd9;
            TouchArea { clicked => { root.click(Zone.wifi-join, -1); } }
            VerticalLayout {
                alignment: center;
                HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        border-radius: (26px * S.k);
                        background: @linear-gradient(180deg, #121c38 0%, #0a1024 100%);
                        border-width: 1px;
                        border-color: Theme.line;
                        drop-shadow-blur: (60px * S.k);
                        drop-shadow-color: #000000aa;
                        TouchArea {}
                        VerticalLayout {
                            padding: (40px * S.k);
                            spacing: 0;
                            // The network.
                            HorizontalLayout {
                                spacing: (18px * S.k);
                                Rectangle {
                                    width: (58px * S.k);
                                    height: self.width;
                                    border-radius: (16px * S.k);
                                    background: Theme.accent.with-alpha(0.16);
                                    Image { source: Icons.wifi; colorize: #8fb6ff; width: (30px * S.k); height: self.width; }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    spacing: (4px * S.k);
                                    Text { text: "Join " + root.wj-ssid; font-size: (30px * S.k); font-weight: 700; color: Theme.text; overflow: elide; }
                                    HorizontalLayout {
                                        spacing: (6px * S.k);
                                        alignment: start;
                                        Image { source: Icons.lock; colorize: Theme.text3; width: (15px * S.k); height: self.width; y: (2px * S.k); }
                                        Text { text: root.wj-sub; font-size: (17px * S.k); color: Theme.text3; }
                                    }
                                }
                            }
                            Rectangle { height: (28px * S.k); }
                            // The password.
                            Rectangle {
                                height: (68px * S.k);
                                border-radius: (16px * S.k);
                                background: #050913;
                                border-width: root.wj-error != "" ? (2px * S.k) : 1px;
                                border-color: root.wj-error != "" ? Theme.danger : #3d8bff88;
                                drop-shadow-blur: (18px * S.k);
                                drop-shadow-color: root.wj-error != "" ? #ff5a6a33 : #3d8bff33;
                                HorizontalLayout {
                                    padding-left: (22px * S.k);
                                    padding-right: (22px * S.k);
                                    spacing: (4px * S.k);
                                    alignment: start;
                                    // Before the placeholder, after what's typed.
                                    if !root.wj-busy && root.wj-field == "": Rectangle {
                                        width: (2px * S.k);
                                        height: (30px * S.k);
                                        y: (19px * S.k);
                                        background: #8fb6ff;
                                        opacity: mod(wj.t, 1.0) < 0.55 ? 1 : 0;
                                    }
                                    if root.wj-field == "": Text {
                                        text: "Password";
                                        font-size: (22px * S.k);
                                        color: Theme.text3;
                                        vertical-alignment: center;
                                    }
                                    if root.wj-field != "": Text {
                                        text: root.wj-field;
                                        font-size: root.wj-show ? (24px * S.k) : (28px * S.k);
                                        letter-spacing: root.wj-show ? 0 : (3px * S.k);
                                        color: Theme.text;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                    // The caret, blinking while it waits for the next key.
                                    if !root.wj-busy && root.wj-field != "": Rectangle {
                                        width: (2px * S.k);
                                        height: (30px * S.k);
                                        y: (19px * S.k);
                                        background: #8fb6ff;
                                        opacity: mod(wj.t, 1.0) < 0.55 ? 1 : 0;
                                    }
                                }
                            }
                            Rectangle { height: (14px * S.k); }
                            // What's happening: connecting, a wrong password, or how to type.
                            HorizontalLayout {
                                height: (24px * S.k);
                                spacing: (10px * S.k);
                                if root.wj-busy: Image { source: Icons.spinner; width: (20px * S.k); height: self.width; y: (2px * S.k); transform-rotation: wj.t * 400deg; }
                                Text {
                                    text: root.wj-busy ? "Connecting to " + root.wj-ssid + "…" : root.wj-error != "" ? root.wj-error
                                        : root.pad-hints ? "Choose the letters below" : "Type with your keyboard, or choose the letters below";
                                    font-size: (17px * S.k);
                                    color: root.wj-error != "" && !root.wj-busy ? Theme.danger : Theme.text2;
                                    vertical-alignment: center;
                                }
                            }
                            Rectangle { height: (22px * S.k); }
                            // The keyboard.
                            VerticalLayout {
                                spacing: wj.gap;
                                opacity: root.wj-busy ? 0.4 : 1;
                                animate opacity { duration: 200ms; }
                                for row[r] in [root.wj-row0, root.wj-row1, root.wj-row2, root.wj-row3, root.wj-row4]: HorizontalLayout {
                                    spacing: wj.gap;
                                    alignment: center;
                                    for k[c] in row: Rectangle {
                                        width: wj.key * k.w + wj.gap * (k.w - 1);
                                        height: r == 4 ? (62px * S.k) : (58px * S.k);
                                        border-radius: (14px * S.k);
                                        background: k.focused ? (k.accent ? Theme.accent : #ffffff)
                                            : k.accent ? Theme.accent.with-alpha(0.35) : k.on ? #3d8bff40 : #ffffff12;
                                        border-width: k.on && !k.focused ? (2px * S.k) : 1px;
                                        border-color: k.on && !k.focused ? #8fb6ff : #ffffff14;
                                        drop-shadow-blur: k.focused ? (22px * S.k) : 0;
                                        drop-shadow-color: k.accent ? #0a6cffaa : #8cb9ff99;
                                        transform-scale: k.focused ? 1.06 : 1.0;
                                        animate background, transform-scale { duration: 120ms; }
                                        Text {
                                            text: k.label;
                                            font-size: k.w > 1 ? (18px * S.k) : (24px * S.k);
                                            font-weight: k.w > 1 ? 600 : 500;
                                            color: k.focused && !k.accent ? #0a0d18 : Theme.text;
                                        }
                                        TouchArea { mouse-cursor: pointer; clicked => { root.click(Zone.wifi-join, r * 100 + c); } }
                                    }
                                }
                            }
                            Rectangle { height: (24px * S.k); }
                            // The buttons that do the same without moving there.
                            HorizontalLayout {
                                alignment: center;
                                spacing: (22px * S.k);
                                for h in root.pad-hints
                                    ? [{ key: "□", what: "Delete" }, { key: "△", what: "Space" }, { key: "L1", what: "Shift" }, { key: "R2", what: "Join" }, { key: "○", what: "Cancel" }]
                                    : [{ key: "Enter", what: "Press the key" }, { key: "Tab", what: "Show password" }, { key: "Esc", what: "Cancel" }]: HorizontalLayout {
                                    spacing: (8px * S.k);
                                    KeyCap { text: h.key; round: root.pad-hints && h.key.character-count == 1; }
                                    Text { text: h.what; font-size: (16px * S.k); color: Theme.text3; vertical-alignment: center; }
                                }
                            }
                        }
                    }
                }
            }
        }

        // ------------------------------------------------------------ TRAILER PLAYER
        if root.overlay == 9: Rectangle {
            background: #000000;
            Image {
                width: parent.width;
                height: parent.height;
                source: root.trailer-frame;
                image-fit: contain;
            }
            TouchArea {
                clicked => { root.trailer-action("toggle"); }
                moved => { root.trailer-action("controls"); }
            }
            if root.trailer-loading: Text {
                text: "Loading trailer…";
                font-size: (22px * S.k);
                color: Theme.text2;
            }
            if root.trailer-paused && !root.trailer-loading: Rectangle {
                width: (96px * S.k);
                height: self.width;
                border-radius: self.width / 2;
                background: #00000099;
                border-width: 1px;
                border-color: #ffffff33;
                Image { source: Icons.play; colorize: Theme.text; width: (40px * S.k); height: self.width; }
            }
            // Top: what's playing.
            Rectangle {
                y: 0;
                height: (150px * S.k);
                opacity: root.trailer-controls ? 1 : 0;
                animate opacity { duration: 300ms; easing: ease-out-quad; }
                background: @linear-gradient(180deg, #000000cc 0%, #00000000 100%);
                BackButton {
                    x: (48px * S.k);
                    y: (36px * S.k);
                    pad: root.pad-hints;
                    clicked => { root.trailer-action("close"); }
                }
                VerticalLayout {
                    x: (48px * S.k);
                    y: (84px * S.k);
                    spacing: (2px * S.k);
                    Text { text: "TRAILER"; font-size: (14px * S.k); font-weight: 600; letter-spacing: (2px * S.k); color: Theme.text3; }
                    Text { text: root.trailer-title; font-size: (26px * S.k); font-weight: 600; color: Theme.text; }
                }
            }
            // Bottom: progress and what the buttons do.
            Rectangle {
                y: parent.height - self.height;
                height: (150px * S.k);
                opacity: root.trailer-controls ? 1 : 0;
                animate opacity { duration: 300ms; easing: ease-out-quad; }
                background: @linear-gradient(0deg, #000000cc 0%, #00000000 100%);
                Rectangle {
                    x: (48px * S.k);
                    y: (62px * S.k);
                    width: parent.width - (96px * S.k);
                    height: (6px * S.k);
                    border-radius: (3px * S.k);
                    background: #ffffff33;
                    Rectangle {
                        x: 0;
                        width: parent.width * clamp(root.trailer-progress, 0, 1);
                        height: parent.height;
                        border-radius: parent.border-radius;
                        background: #ffffff;
                    }
                    TouchArea {
                        y: -(12px * S.k);
                        height: parent.height + (24px * S.k);
                        mouse-cursor: pointer;
                        clicked => { root.trailer-action("seek:" + (self.mouse-x / self.width)); }
                    }
                }
                Text {
                    x: (48px * S.k);
                    y: (86px * S.k);
                    text: root.trailer-time;
                    font-size: (17px * S.k);
                    color: Theme.text2;
                }
                HorizontalLayout {
                    width: self.preferred-width;
                    height: (30px * S.k);
                    x: parent.width - self.width - (48px * S.k);
                    y: (82px * S.k);
                    spacing: (10px * S.k);
                    KeyCap { text: root.pad-hints ? "✕" : "Enter"; round: root.pad-hints; }
                    Text { text: root.trailer-paused ? "Play" : "Pause"; font-size: (17px * S.k); color: Theme.text2; vertical-alignment: center; }
                    Rectangle { width: (14px * S.k); }
                    KeyCap { text: "◂ ▸"; }
                    Text { text: "10 s"; font-size: (17px * S.k); color: Theme.text2; vertical-alignment: center; }
                    Rectangle { width: (14px * S.k); }
                    KeyCap { text: root.pad-hints ? "○" : "Esc"; round: root.pad-hints; }
                    Text { text: "Close"; font-size: (17px * S.k); color: Theme.text2; vertical-alignment: center; }
                }
            }
        }

        // ------------------------------------------------------------ KEYBOARD CONTROLS
        if root.overlay == 10: Rectangle {
            background: #03050ccc;
            TouchArea { clicked => { root.click(Zone.controls, -1); } }
            VerticalLayout {
                alignment: center;
                HorizontalLayout {
                alignment: center;
            Rectangle {
                border-radius: (22px * S.k);
                background: @linear-gradient(180deg, #111a33 0%, #0a1024 100%);
                border-width: 1px;
                border-color: Theme.line;
                TouchArea {}
                VerticalLayout {
                    padding-left: (48px * S.k);
                    padding-right: (48px * S.k);
                    padding-top: (40px * S.k);
                    padding-bottom: (40px * S.k);
                    spacing: (10px * S.k);
                    Text { text: "Keyboard controls in games"; font-size: (30px * S.k); font-weight: 600; color: Theme.text; }
                    Text { text: root.launch-controller; font-size: (17px * S.k); color: root.launch-keyboard ? Theme.text3 : Theme.ok; }
                    Rectangle { height: (6px * S.k); }
                    // PS5 and PS4 games use different emulators, with different keys.
                    HorizontalLayout {
                        alignment: start;
                        spacing: (8px * S.k);
                        for tab[i] in ["PS5 games · KytyPS5", "PS4 games · shadPS4"]: Rectangle {
                            property <bool> on: (i == 1) == root.controls-ps4;
                            width: tl.preferred-width + (28px * S.k);
                            height: (36px * S.k);
                            border-radius: (18px * S.k);
                            background: on ? #ffffff : #ffffff14;
                            tl := Text { text: tab; font-size: (16px * S.k); font-weight: 600; color: on ? #0a0d18 : Theme.text2; }
                            TouchArea { mouse-cursor: pointer; clicked => { root.click(Zone.controls, i); } }
                        }
                        Text { text: "  ◂ ▸ to switch"; font-size: (15px * S.k); color: Theme.text3; vertical-alignment: center; }
                    }
                    Rectangle { height: (6px * S.k); }
                    if root.controls-ps4: HorizontalLayout {
                        spacing: (56px * S.k);
                        for column in [
                            [{ what: "✕  Cross", keys: "N  (or keypad 2)" }, { what: "○  Circle", keys: "B  (or keypad 6)" }, { what: "□  Square", keys: "V  (or keypad 4)" },
                             { what: "△  Triangle", keys: "C  (or keypad 8)" }, { what: "D-pad", keys: "Arrow keys" }, { what: "Options", keys: "Enter" }],
                            [{ what: "Left stick", keys: "W  A  S  D" }, { what: "Right stick", keys: "I  J  K  L" }, { what: "L1  /  R1", keys: "Q  /  U" },
                             { what: "L2  /  R2", keys: "E  /  O" }, { what: "L3  /  R3", keys: "X  /  M" }, { what: "Touchpad", keys: "Space" }],
                        ]: VerticalLayout {
                            spacing: (12px * S.k);
                            for row in column: HorizontalLayout {
                                height: (30px * S.k);
                                spacing: (16px * S.k);
                                Text { text: row.what; width: (150px * S.k); font-size: (19px * S.k); color: Theme.text2; vertical-alignment: center; }
                                KeyCap { text: row.keys; }
                            }
                        }
                    }
                    if !root.controls-ps4: HorizontalLayout {
                        spacing: (56px * S.k);
                        for column in [
                            [{ what: "✕  Cross", keys: "J" }, { what: "○  Circle", keys: "L" }, { what: "□  Square", keys: "K" }, { what: "△  Triangle", keys: "I" },
                             { what: "D-pad", keys: "Arrow keys" }, { what: "Options", keys: "Enter" }],
                            [{ what: "Left stick", keys: "W  A  S  D" }, { what: "Right stick", keys: "T  F  G  H" }, { what: "L1  /  R1", keys: "Q  /  E" },
                             { what: "L2  /  R2", keys: "Z  /  C" }, { what: "L3  /  R3", keys: "Left Shift  /  Left Ctrl" }, { what: "Touchpad", keys: "Backspace  /  Tab" }],
                        ]: VerticalLayout {
                            spacing: (12px * S.k);
                            for row in column: HorizontalLayout {
                                height: (30px * S.k);
                                spacing: (16px * S.k);
                                Text { text: row.what; width: (150px * S.k); font-size: (19px * S.k); color: Theme.text2; vertical-alignment: center; }
                                KeyCap { text: row.keys; }
                            }
                        }
                    }
                    Rectangle { height: (10px * S.k); }
                    Text { text: root.controls-ps4 ? "shadPS4 keeps its key layout in its own settings file; these are its defaults." : "F7 turns the mouse into the right stick (press it again to release the mouse)."; font-size: (16px * S.k); color: Theme.text3; }
                    Text {
                        text: "Games play best with a controller: DualSense, DualShock 4, Xbox and most others work\nover USB or Bluetooth with no setup. Connect it before starting a game.";
                        font-size: (16px * S.k);
                        color: Theme.text3;
                    }
                    Rectangle { height: (6px * S.k); }
                    HorizontalLayout {
                        alignment: start;
                        BackButton { pad: root.pad-hints; clicked => { root.click(Zone.controls, -1); } }
                    }
                }
            }
                }
            }
        }

        // ------------------------------------------------------------ TOASTS
        VerticalLayout {
            x: root.width - (48px * S.k) - (440px * S.k);
            y: (104px * S.k);
            width: (440px * S.k);
            spacing: (12px * S.k);
            alignment: start;
            for t in root.toasts: Toast { data: t; clicked => { root.toast-clicked(t.id, t.action); } }
        }
    }
}
