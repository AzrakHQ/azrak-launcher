// Colors, icons and shared data types. Everything is laid out on a 1920×1080 logical
// canvas; the Rust side sets the scale factor so it fills the chosen display exactly.

import "../assets/fonts/Inter-Regular.ttf";
import "../assets/fonts/Inter-Medium.ttf";
import "../assets/fonts/Inter-SemiBold.ttf";
import "../assets/fonts/Inter-Bold.ttf";

// UI scale: the layout is designed on a 1920×1080 canvas; k maps it to the real window
// (set from Rust on every resize, so any screen size or monitor works).
export global S {
    in property <float> k: 1.0;
    // Text that must stay readable (Settings, dialogs) uses t: k, but never below 0.75, like the
    // Library's type scale. On a small window the layout shrinks further than the words.
    in property <float> t: 1.0;
}

export global Theme {
    out property <color> bg: #05070f;
    out property <color> panel: #121a31;
    out property <color> text: #f5f7fb;
    out property <color> text2: #b9c3da;
    out property <color> text3: #7d88a3;
    out property <color> accent: #0a6cff;
    out property <color> ok: #3ddc97;
    out property <color> warn: #ffb547;
    out property <color> danger: #ff5a6a;
    out property <color> line: #ffffff1c;
    out property <color> ring: #ffffff;
    out property <color> glow: #0a6cff8c;
    out property <duration> fast: 160ms;

    // KytyPS5 compatibility colours: in-game, menus, boots, doesn't boot, untested.
    public pure function compat-color(level: int) -> color {
        return level == 1 ? #3ddc97 : level == 2 ? #ffd24d : level == 3 ? #ff9f43 : level == 4 ? #ff5a6a : #8a93ab;
    }
    out property <duration> move: 240ms;
}

export global Icons {
    out property <image> search: @image-url("../assets/icons/search.svg");
    out property <image> gear: @image-url("../assets/icons/gear.svg");
    out property <image> play: @image-url("../assets/icons/play.svg");
    out property <image> film: @image-url("../assets/icons/film.svg");
    out property <image> info: @image-url("../assets/icons/info.svg");
    out property <image> grid: @image-url("../assets/icons/grid.svg");
    out property <image> web: @image-url("../assets/icons/web.svg");
    out property <image> disk: @image-url("../assets/icons/disk.svg");
    out property <image> cal: @image-url("../assets/icons/cal.svg");
    out property <image> user: @image-url("../assets/icons/user.svg");
    out property <image> tag: @image-url("../assets/icons/tag.svg");
    out property <image> stop: @image-url("../assets/icons/stop.svg");
    out property <image> star: @image-url("../assets/icons/star.svg");
    out property <image> bag: @image-url("../assets/icons/bag.svg");
    out property <image> power: @image-url("../assets/icons/power.svg");
    out property <image> chevl: @image-url("../assets/icons/chevl.svg");
    out property <image> chevr: @image-url("../assets/icons/chevr.svg");
    out property <image> chevd: @image-url("../assets/icons/chevd.svg");
    out property <image> check: @image-url("../assets/icons/check.svg");
    out property <image> folder: @image-url("../assets/icons/folder.svg");
    out property <image> log: @image-url("../assets/icons/log.svg");
    out property <image> alert: @image-url("../assets/icons/alert.svg");
    out property <image> app: @image-url("../assets/icons/app-icon.svg");
    out property <image> spinner: @image-url("../assets/icons/spinner.svg");
    out property <image> wifi: @image-url("../assets/icons/wifi.svg");
    out property <image> lock: @image-url("../assets/icons/lock.svg");
    out property <image> none;

    public pure function get(name: string) -> image {
        return name == "play" ? play : name == "stop" ? stop : name == "film" ? film : name == "info" ? info
            : name == "grid" ? grid : name == "web" ? web : name == "disk" ? disk : name == "cal" ? cal
            : name == "user" ? user : name == "tag" ? tag : name == "star" ? star : name == "bag" ? bag
            : name == "power" ? power : name == "search" ? search : name == "gear" ? gear
            : name == "check" ? check : name == "folder" ? folder : name == "log" ? log : none;
    }
}

// Focus zones (mirrored in src/app.rs).
export global Zone {
    out property <int> tabs: 0;
    out property <int> top: 1;
    out property <int> row: 2;
    out property <int> actions: 3;
    out property <int> search: 4;
    out property <int> sort: 5;
    out property <int> chips: 6;
    out property <int> grid: 7;
    out property <int> hub: 8;
    out property <int> shots: 9;
    out property <int> desc: 10;
    out property <int> settings: 11;
    out property <int> menu: 12;
    out property <int> downloads: 13;
    out property <int> releases: 14;
    out property <int> hub-details: 15;
    out property <int> sort-picker: 16;
    out property <int> density: 17;
    out property <int> trailer: 18;
    out property <int> controls: 19;
    out property <int> os-install: 20;
    out property <int> wifi-join: 21;
}

// dot: KytyPS5 compatibility level (0 none, 1 in-game, 2 menus, 3 boots, 4 doesn't boot, 5 untested)
// stars: star rating out of 5 drawn as five stars (0 = none)
export struct ChipData { icon: string, text: string, gold: bool, dot: int, stars: float }
export struct ActionData { id: string, label: string, icon: string, primary: bool, danger: bool, round: bool }
export struct DownloadData {
    key: string, title: string, state: string, progress: float, detail: string,
    path: string, error: string, failed: bool, complete: bool,
    primary: string, primary-action: string, secondary: string, secondary-action: string,
    review: bool, files: string, file-summary: string,
}

export struct TileData {
    image: image,
    loaded: bool,
    special: bool,
    badge: string,      // "", "Installed", "Playing", "New"
}

export struct HeroData {
    kicker: string,
    kicker-accent: string,   // green/colored segment ("● Installed", "● Playing")
    kicker-live: bool,
    title: string,
    logo: image,
    has-logo: bool,
    logo-w: length,
    logo-h: length,
    chips: [ChipData],
    desc: string,
    actions: [ActionData],
}

export struct CardData {
    index: int,
    title: string,
    meta: string,
    // How easy it is to download ("Good", "Low", "None", "Unknown"), from the catalog's seeder
    // count; kind: 1 good, 2 low, 4 none or unknown (the Fact colours).
    availability: string,
    availability-kind: int,
    releases: string,
    rating: string,
    badge: string,
    compat: string,
    compat-level: int,
    // "PS4" / "PS5" when the Library has more than one console; empty otherwise.
    console: string,
    image: image,
    loaded: bool,
    // Nothing to load (no artwork found, or its download failed): a placeholder with the name.
    no-art: bool,
}

export struct CardRow { index: int, cards: [CardData] }
export struct GenreChip { index: int, label: string, count: string, on: bool, x: length, w: length }
export struct Fact { key: string, value: string, /* 1 good, 2 warning, 3 bad, 4 none (grey) */ kind: int }
export struct FactRow { items: [Fact] }
export struct Shot { image: image, loaded: bool }

export struct HubData {
    kicker: string,
    kicker-accent: string,
    kicker-live: bool,
    title: string,
    logo: image,
    has-logo: bool,
    logo-w: length,
    logo-h: length,
    cover: image,
    cover-loaded: bool,
    // No artwork at all: the console's colours and name instead.
    no-art: bool,
    console: string,
    chips: [ChipData],
    age-icon: image,
    actions: [ActionData],
    facts: [FactRow],
    details: [FactRow],
    subtitle: string,
    // Will it play here? One headline (kind: the Fact colours, 0 grey) and the results behind it.
    verdict: string,
    verdict-kind: int,
    verdict-detail: string,
    // Under Download: its size, where it goes and what comes next; warn: not enough free space.
    download-note: string,
    download-note-warn: bool,
    // The release picker: "Version 3 of 3 (newest)" and that release's version, region and size.
    release-label: string,
    release-detail: string,
    release-count: int,
    shots: [Shot],
    about: [string],
}

export struct SettingData {
    kind: int,        // 0 header, 1 text, 2 toggle, 3 cycle, 4 button
    label: string,
    value: string,
    on: bool,
    hint: string,
    hint-kind: int,   // 0 dim, 1 good, 2 bad
    secret: bool,
    danger: bool,
    value-kind: int,  // 0 dim, 1 good, 2 bad, 3 call to action
    group-first: bool, // rows of a section share one card
    group-last: bool,
}

// kind 0 info, 1 ok, 2 error. image: a picture for the icon tile (app or game icon), if any.
// state: 0 waiting, 1 in progress, 2 done, 3 failed
export struct BootStep { label: string, detail: string, state: int }

// A disk on the AzrakOS installer's list: its model, size and notes, warn when Windows is on it.
export struct OsiDisk { label: string, detail: string, warn: bool }
// A key on the Wi-Fi password keyboard: w is its width in keys; on: a toggle that's on (Shift).
export struct WjKey { label: string, w: float, focused: bool, accent: bool, on: bool }

// action: what clicking the notification does (empty: nothing).
export struct ToastData { id: int, text: string, sub: string, kind: int, image: image, has-image: bool, app: bool, action: string }
export struct MenuItem { label: string, icon: string }
export struct RunningData { active: bool, name: string, time: string }
